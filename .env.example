# Optional: copy to apps/web/.env.local. No credentials are needed for M0.
# Every flag accepts only false or unset. Activation fails startup/build.
VYNVORI_IDENTITY_CENTRAL_SSO=false
VYNVORI_COMMERCE_CHECKOUT_LIVE=false
VYNVORI_PAYMENTS_LIVE=false
VYNVORI_STUDIO_AI_GENERATION_PAID=false
VYNVORI_STUDIO_PREMIUM_FINAL=false
VYNVORI_STUDIO_ADVANCED_MODEL_SELECTOR=false
VYNVORI_STUDIO_FREE_PROMO=false
VYNVORI_CREDITS_PURCHASING=false
VYNVORI_EXPORTS_PAID=false
VYNVORI_PRODUCTION_PRINT_RELEASE=false
VYNVORI_GALLERY_PUBLICATION=false
VYNVORI_ASSETS_PRODUCTION_UPLOADS=false
VYNVORI_SHIPPING_AUSTRALIA_BATCH=false

# M2 service-only placeholders. Configure dedicated staging credentials only
# in the relevant service/operator environment, never NEXT_PUBLIC_* or production.
# M2_ENV=local
# M2_CREATIVE_DATABASE_URL=
# M2_CREATIVE_DATABASE_HOST=
# M2_CREATIVE_MIGRATION_DATABASE_URL= # Separate scoped migration identity; direct staging URL
# M2_CREATIVE_MIGRATION_DATABASE_HOST=
# M2_MEDUSA_ORIGIN=
# M2_R2_ACCOUNT_ID=
# M2_R2_JURISDICTION= # Explicit staging jurisdiction: default, us or eu
# M2_R2_BUCKET=
# M2_R2_ACCESS_KEY_ID=
# M2_R2_SECRET_ACCESS_KEY=
# M2_R2_CONTROL_API_TOKEN= # Ephemeral operator-only control-plane read credential; never public
# M2_R2_PROBE_JOURNAL= # Existing external journal path when reconciling an interrupted smoke
# M2_PROCESSING_ORIGIN=
# M2_PROCESSING_TOKEN=
# M2_PROCESSING_ID_TOKEN=

# M3 composition limits (ADR-0022). Server-only; never NEXT_PUBLIC_*. NO key has a default: an unset or invalid key keeps the
# capability that needs it closed (503 COMPOSITION_LIMITS_NOT_CONFIGURED). Values are canonical positive integers supplied by
# the founder; this file deliberately contains none. Image bytes and side length above the 0001 CHECKs are rejected at startup.
# M3_LIMIT_GUEST_TTL_SECONDS=
# M3_LIMIT_IMAGE_MAX_BYTES=
# M3_LIMIT_IMAGE_MAX_PIXELS=
# M3_LIMIT_IMAGE_MAX_SIDE_PX=
# M3_LIMIT_MAX_ASSETS_PER_COMPOSITION=
# M3_LIMIT_MAX_BYTES_PER_COMPOSITION=
# M3_LIMIT_JSON_MAX_BYTES=
# M3_LIMIT_DOWNLOAD_GRANT_TTL_SECONDS=
# M3_LIMIT_SCAN_TIMEOUT_SECONDS=
# M3_LIMIT_SCAN_LEASE_SECONDS=
# M3_LIMIT_LIVE_GUEST_DRAFTS_MAX=
# M3_LIMIT_RATE_GUEST_CREATE_GLOBAL_WINDOW_SECONDS=
# M3_LIMIT_RATE_GUEST_CREATE_GLOBAL_MAX=
# M3_LIMIT_RATE_ASSET_UPLOAD_GLOBAL_WINDOW_SECONDS=
# M3_LIMIT_RATE_ASSET_UPLOAD_GLOBAL_MAX=
# M3_LIMIT_RATE_GUEST_WRITE_WINDOW_SECONDS=
# M3_LIMIT_RATE_GUEST_WRITE_MAX=
# M3_LIMIT_RATE_GUEST_ASSET_UPLOAD_WINDOW_SECONDS=
# M3_LIMIT_RATE_GUEST_ASSET_UPLOAD_MAX=
# M3_LIMIT_RATE_GUEST_DOWNLOAD_GRANT_WINDOW_SECONDS=
# M3_LIMIT_RATE_GUEST_DOWNLOAD_GRANT_MAX=
# M3_LIMIT_RATE_GUEST_RESCAN_WINDOW_SECONDS=
# M3_LIMIT_RATE_GUEST_RESCAN_MAX=
# M3_LIMIT_RATE_OWNER_WRITE_WINDOW_SECONDS=
# M3_LIMIT_RATE_OWNER_WRITE_MAX=
# M3_LIMIT_RATE_OWNER_ASSET_UPLOAD_WINDOW_SECONDS=
# M3_LIMIT_RATE_OWNER_ASSET_UPLOAD_MAX=
# M3_LIMIT_RATE_OWNER_DOWNLOAD_GRANT_WINDOW_SECONDS=
# M3_LIMIT_RATE_OWNER_DOWNLOAD_GRANT_MAX=
# M3_LIMIT_RATE_OWNER_RESCAN_WINDOW_SECONDS=
# M3_LIMIT_RATE_OWNER_RESCAN_MAX=
