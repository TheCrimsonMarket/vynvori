+          } else if (body.grant_type === 'refresh_token') {
+            if (Object.keys(body).some((field) => !['grant_type', 'refresh_token'].includes(field))) return error(res, 400, 'invalid_request');
+            result = await authority.refresh({ clientSecret: auth.clientSecret, refreshToken: body.refresh_token });
+          } else return error(res, 400, 'unsupported_grant_type');
+        } else {
+          if (Object.keys(body).some((field) => !['token'].includes(field)) || !body.token) return error(res, 400, 'invalid_request');
+          result = await authority[operation]({ clientSecret: auth.clientSecret, token: body.token });
+        }
+        if (result.status === 'unavailable') return error(res, 503, 'temporarily_unavailable');
+        if (result.status === 'outcome_unknown') return res.status(503).json({ error: 'outcome_unknown', operation_id: result.operationId, reauth_required: true });
+        if (operation === 'introspect') {
+          if (result.status !== 'ok') return res.json({ active: false });
+          const { identity } = result;
+          return res.json({
+            active: true, iss: identity.issuer, sub: identity.subject, client_id: identity.clientId, aud: identity.audience, exp: Math.floor(identity.expiresAt / 1000), verified_at: Math.floor(identity.verifiedAt / 1000),
+          });
+        }
+        if (result.status !== 'ok') return error(res, 400, operation === 'token' ? 'invalid_grant' : 'invalid_request');
+        return res.json(operation === 'token' ? result.tokens : {});
+      } catch {
+        return error(res, 503, 'temporarily_unavailable');
+      }
+    };
+  }
+  router.post('/token', handler('token'));
+  router.post('/introspect', handler('introspect'));
+  router.post('/revoke', handler('revoke'));
+  router.use((err, _req, res, next) => {
+    if (res.headersSent) return next(err);
+    return error(res, err?.type === 'entity.too.large' ? 413 : 400, 'invalid_request');
+  });
+  app.use('/oauth/strict/v1', router);
+  app.use('/mana/oauth/strict/v1', router);
+}
