@@ -0,0 +1,158 @@
+import express from 'express';
+import request from 'supertest';
+import { registerStrictOAuthRoutes, createStrictTransportPreflight, createStrictAuthorizationPreflight } from '../routes/oauthStrictRoutes';
+
+describe('isolated strict OAuth server transport', () => {
+  let app;
+  let authority;
+  let resolveAuthority;
+  let allowRequest;
+  const credentials = Buffer.from('synthetic-client:synthetic-secret').toString('base64');
+  beforeEach(() => {
+    app = express();
+    app.post('/oauth/token', (_req, res) => res.json({ legacy: true }));
+    authority = {
+      authenticateClient: jest.fn(async () => ({ status: 'ok' })),
+      exchange: jest.fn(async () => ({
+        status: 'ok',
+        tokens: {
+          access_token: 'synthetic-access', refresh_token: 'synthetic-refresh', token_type: 'Bearer', expires_in: 120, scope: 'profile',
+        },
+      })),
+      refresh: jest.fn(async () => ({ status: 'reauth_required' })),
+      introspect: jest.fn(async () => ({
+        status: 'ok',
+        identity: {
+          issuer: 'urn:synthetic', subject: 'synthetic-sub', clientId: 'synthetic-client', audience: 'urn:synthetic:product', expiresAt: 123000, verifiedAt: 100000,
+        },
+      })),
+      revoke: jest.fn(async () => ({ status: 'ok' })),
+    };
+    resolveAuthority = jest.fn(async () => authority);
+    allowRequest = jest.fn(async () => true);
+    registerStrictOAuthRoutes(app, { resolveAuthority, allowRequest });
+  });
+  const post = (path, body) => request(app).post(`/oauth/strict/v1/${path}`).set('Authorization', `Basic ${credentials}`).type('form')
+    .send(body);
+
+  test('exchanges through strict authority without affecting the legacy endpoint', async () => {
+    const response = await post('token', {
+      grant_type: 'authorization_code', code: 'synthetic-code', redirect_uri: 'https://synthetic.invalid/callback', code_verifier: 'synthetic-verifier',
+    });
+    expect(response.status).toBe(200);
+    expect(response.body.access_token).toBe('synthetic-access');
+    expect(response.headers['cache-control']).toBe('no-store');
+    expect(authority.exchange).toHaveBeenCalledWith({
+      clientSecret: 'synthetic-secret', code: 'synthetic-code', redirectUri: 'https://synthetic.invalid/callback', codeVerifier: 'synthetic-verifier',
+    });
+    expect((await request(app).post('/oauth/token')).body).toEqual({ legacy: true });
+  });
+
+  test('mana alias uses the same server boundary', async () => {
+    const response = await request(app).post('/mana/oauth/strict/v1/revoke').set('Authorization', `Basic ${credentials}`).type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({});
+  });
+
+  test.each(['Origin', 'Cookie'])('rejects browser %s headers before calling an authority', async (header) => {
+    const response = await post('revoke', { token: 'synthetic' }).set(header, header === 'Origin' ? 'https://synthetic.invalid' : 'synthetic=value');
+    expect(response.status).toBe(401);
+    expect(resolveAuthority).not.toHaveBeenCalled();
+  });
+
+  test('does not accept body credentials, issuer/audience overrides or repeated parameters', async () => {
+    const bodies = ['token=synthetic&client_secret=synthetic', 'token=synthetic&issuer=urn:other', 'token=synthetic&token=other'];
+    const responses = await Promise.all(bodies.map((body) => post('revoke', body)));
+    expect(responses.map((response) => response.status)).toEqual([400, 400, 400]);
+    expect(authority.revoke).not.toHaveBeenCalled();
+  });
+
+  test.each(['Bearer synthetic', 'Basic !!!', 'Basic c3ludGhldGlj', ''])('rejects invalid authorization %s', async (authorization) => {
+    const response = await request(app).post('/oauth/strict/v1/revoke').set('Authorization', authorization).type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(401);
+    expect(resolveAuthority).not.toHaveBeenCalled();
+  });
+
+  test('rejects duplicate authorization headers', async () => {
+    const response = await request(app).post('/oauth/strict/v1/revoke').set('Authorization', [`Basic ${credentials}`, `Basic ${credentials}`]).type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(401);
+    expect(authority.revoke).not.toHaveBeenCalled();
+  });
+
+  test('rejects JSON and excessive form bodies without leaking parser diagnostics', async () => {
+    expect((await request(app).post('/oauth/strict/v1/revoke').set('Authorization', `Basic ${credentials}`).send({ token: 'synthetic' })).status).toBe(415);
+    const response = await post('revoke', { token: 'x'.repeat(25000) });
+    expect(response.status).toBe(413);
+    expect(response.body).toEqual({ error: 'invalid_request' });
+  });
+
+  test('invalid client is 401; rate-limit denial is 429 and never executes the operation', async () => {
+    authority.authenticateClient.mockResolvedValue({ status: 'unauthenticated' });
+    expect((await post('revoke', { token: 'synthetic' })).status).toBe(401);
+    allowRequest.mockResolvedValue(false);
+    expect((await post('revoke', { token: 'synthetic' })).status).toBe(429);
+    expect(authority.revoke).not.toHaveBeenCalled();
+  });
+
+  test('introspection exposes only sanitized authority binding', async () => {
+    const response = await post('introspect', { token: 'synthetic' });
+    expect(response.body).toEqual({
+      active: true, iss: 'urn:synthetic', sub: 'synthetic-sub', client_id: 'synthetic-client', aud: 'urn:synthetic:product', exp: 123, verified_at: 100,
+    });
+    authority.introspect.mockResolvedValue({ status: 'unauthenticated' });
+    expect((await post('introspect', { token: 'synthetic' })).body).toEqual({ active: false });
+  });
+
+  test('unknown rotation result requires reauth and is never returned as a generic retryable success', async () => {
+    authority.refresh.mockResolvedValue({ status: 'outcome_unknown', operationId: 'synthetic-operation' });
+    const response = await post('token', { grant_type: 'refresh_token', refresh_token: 'synthetic' });
+    expect(response.status).toBe(503);
+    expect(response.body).toEqual({ error: 'outcome_unknown', operation_id: 'synthetic-operation', reauth_required: true });
+  });
+
+  test('upstream failures are sanitized and failed revocation is not successful logout', async () => {
+    authority.revoke.mockResolvedValue({ status: 'unavailable' });
+    expect((await post('revoke', { token: 'synthetic' })).status).toBe(503);
+    resolveAuthority.mockRejectedValue(new Error('synthetic-private-error'));
+    expect((await post('revoke', { token: 'synthetic' })).body).toEqual({ error: 'temporarily_unavailable' });
+  });
+
+  test('configuration cannot silently omit authority or rate-limit enforcement', () => {
+    expect(() => registerStrictOAuthRoutes(express(), { resolveAuthority })).toThrow();
+  });
+
+  test('strict preflight enforces its cap before Portal global parsers without restricting legacy paths', async () => {
+    const instance = express();
+    instance.use(['/oauth/strict/v1', '/mana/oauth/strict/v1'], createStrictTransportPreflight());
+    instance.use(express.urlencoded({ extended: true, limit: '100kb' }));
+    instance.use(express.json({ limit: '10mb' }));
+    registerStrictOAuthRoutes(instance, { resolveAuthority, allowRequest });
+    instance.post('/legacy', (_req, res) => res.json({ legacy: true }));
+    const payload = { token: 'x'.repeat(25000) };
+    const strict = await request(instance).post('/oauth/strict/v1/revoke').auth('synthetic', 'synthetic').type('form')
+      .send(payload);
+    expect(strict.status).toBe(413);
+    expect(strict.body).toEqual({ error: 'invalid_request' });
+    expect(authority.revoke).not.toHaveBeenCalled();
+    const legacy = await request(instance).post('/legacy').type('form').send(payload);
+    expect(legacy.status).toBe(200);
+    expect(legacy.body).toEqual({ legacy: true });
+  });
+
+  test('strict authorizer preflight supports the existing JSON consent shape and bounds only its new alias', async () => {
+    const instance = express();
+    instance.use('/mana/oauth/authorize', createStrictAuthorizationPreflight());
+    instance.use(express.json({ limit: '10mb' }));
+    instance.get('/mana/oauth/authorize', (_req, res) => res.json({ ready: true }));
+    instance.post('/mana/oauth/authorize', (req, res) => res.json({ approved: req.body.approved }));
+    instance.post('/legacy', (_req, res) => res.json({ legacy: true }));
+    expect((await request(instance).get('/mana/oauth/authorize')).status).toBe(200);
+    expect((await request(instance).post('/mana/oauth/authorize').send({ approved: true })).body).toEqual({ approved: true });
+    expect((await request(instance).post('/mana/oauth/authorize').send({ value: 'x'.repeat(25000) })).status).toBe(413);
+    expect((await request(instance).post('/mana/oauth/authorize').type('form').send({ approved: 'true' })).status).toBe(415);
+    expect((await request(instance).post('/legacy').send({ value: 'x'.repeat(25000) })).status).toBe(200);
+  });
+});
