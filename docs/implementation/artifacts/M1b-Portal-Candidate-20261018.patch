+import { createStrictAuthority } from './oauthStrictAuthority';
+import { createStrictAuthorizationGuard } from './oauthStrictAuthorizationGuard';
+import { createStrictFamilyStore } from './oauthStrictFamilyStore';
+
+const FAMILY_COLLECTION = 'oauth_strict_families_v1';
+const RATE_COLLECTION = 'oauth_strict_rate_windows_v1';
+const fields = ['clientId', 'issuer', 'audience', 'redirectUri', 'accessTtlSeconds', 'familyTtlSeconds', 'maxRotations'];
+const validText = (value) => typeof value === 'string' && value.length > 0 && value.length <= 2048 && value.trim() === value;
+
+function parseConfiguration(raw) {
+  if (typeof raw !== 'string' || raw.length > 65536) throw new TypeError('Invalid strict configuration');
+  const config = JSON.parse(raw);
+  if (!config || config.version !== 1 || Object.keys(config).some((field) => !['version', 'webOrigin', 'clients'].includes(field))
+    || !validText(config.webOrigin) || !config.webOrigin.startsWith('https://') || new URL(config.webOrigin).origin !== config.webOrigin
+    || !Array.isArray(config.clients) || !config.clients.length) throw new TypeError('Invalid strict configuration');
+  const policies = new Map();
+  config.clients.forEach((policy) => {
+    if (!policy || Object.keys(policy).length !== fields.length || Object.keys(policy).some((field) => !fields.includes(field))
+      || ![policy.clientId, policy.issuer, policy.audience, policy.redirectUri].every(validText)
+      || ![policy.accessTtlSeconds, policy.familyTtlSeconds, policy.maxRotations].every((value) => Number.isSafeInteger(value) && value > 0)
+      || policy.familyTtlSeconds < policy.accessTtlSeconds || policy.maxRotations > 4096
+      || !Number.isFinite(new Date(Date.now() + policy.familyTtlSeconds * 1000).getTime())
+      || policies.has(policy.clientId)) throw new TypeError('Invalid strict client configuration');
+    const callback = new URL(policy.redirectUri);
+    if (callback.protocol !== 'https:' || callback.href !== policy.redirectUri || callback.username || callback.password || callback.search || callback.hash) throw new TypeError('Invalid strict callback');
+    policies.set(policy.clientId, Object.freeze({ ...policy }));
+  });
+  return { webOrigin: config.webOrigin, policies };
+}
+
+function unavailableRuntime(policies = new Map()) {
+  return {
+    diagnostic: Object.freeze({ enabled: true, configurationValid: false }),
+    isEnrolled: (clientId) => policies.has(clientId),
+    authorizationGuard(req, res, next) {
+      const clientId = (req.method === 'GET' ? req.query : req.body)?.client_id;
+      if (!policies.has(clientId)) return next();
+      return res.status(503).set('Cache-Control', 'no-store').json({ error: 'temporarily_unavailable' });
+    },
+    async resolveAuthority() { throw new Error('Strict identity runtime unavailable'); },
+    async allowRequest() { throw new Error('Strict identity runtime unavailable'); },
+  };
+}
+
+// Constructor is read-only; it never creates collections/indexes or modifies clients.
+export function createStrictOAuthRuntime({
+  environment = {}, getDatabase, getAuthorizationCodes, readClient, readSubjectState, refreshSigningKey,
+} = {}) {
+  if (environment.PORTAL_STRICT_OAUTH_ENABLED === undefined || environment.PORTAL_STRICT_OAUTH_ENABLED === 'false') return null;
+  let configuration;
