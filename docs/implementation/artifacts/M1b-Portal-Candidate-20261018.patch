+import express from 'express';
+import request from 'supertest';
+import oauthRoutes from '../routes/oauthRoutes';
+
+jest.mock('mongoose', () => ({ __esModule: true, default: { model: jest.fn() } }));
+jest.mock('../controllers/oauthController', () => new Proxy({ __esModule: true }, {
+  get: (target, name) => (name === '__esModule' ? true : (_req, res) => res.json({ legacy: true })),
+}));
+jest.mock('../controllers/oauthDeveloperController', () => new Proxy({ __esModule: true }, {
+  get: (target, name) => (name === '__esModule' ? true : (_req, res) => res.json({ legacy: true })),
+}));
+jest.mock('../controllers/oauthServiceClientController', () => new Proxy({ __esModule: true }, {
+  get: (target, name) => (name === '__esModule' ? true : (_req, res) => res.json({ legacy: true })),
+}));
+
+describe('actual OAuth route registration keeps strict activation default-off', () => {
+  const keys = ['PORTAL_STRICT_OAUTH_ENABLED', 'PORTAL_STRICT_OAUTH_CONFIG', 'PORTAL_STRICT_OAUTH_SIGNING_KEY'];
+  const original = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+  beforeEach(() => keys.forEach((key) => { delete process.env[key]; }));
+  afterAll(() => keys.forEach((key) => {
+    if (original[key] === undefined) delete process.env[key];
+    else process.env[key] = original[key];
+  }));
+  function app() {
+    const instance = express();
+    instance.use(express.json());
+    oauthRoutes(instance, { loginRequired: (_req, _res, next) => next() });
+    return instance;
+  }
+  test('existing authorize/token/aliases remain usable with no strict flag', async () => {
+    const instance = app();
+    expect((await request(instance).get('/oauth/authorize').query({ client_id: 'legacy' })).body).toEqual({ legacy: true });
+    expect((await request(instance).post('/oauth/token').send({ grant_type: 'refresh_token' })).body).toEqual({ legacy: true });
+    expect((await request(instance).post('/mana/oauth/revoke').send({ token: 'synthetic' })).body).toEqual({ legacy: true });
+    expect((await request(instance).post('/oauth/strict/v1/token')).status).toBe(404);
+    expect((await request(instance).get('/mana/oauth/authorize')).status).toBe(404);
+  });
+  test('invalid enabled strict settings keep legacy authorize available and expose only strict unavailability', async () => {
+    process.env.PORTAL_STRICT_OAUTH_ENABLED = 'true';
+    process.env.PORTAL_STRICT_OAUTH_CONFIG = '{invalid';
+    const instance = app();
+    expect((await request(instance).get('/oauth/authorize').query({ client_id: 'legacy' })).status).toBe(200);
+    const response = await request(instance).post('/oauth/strict/v1/revoke').auth('synthetic', 'synthetic').type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(503);
+    expect((await request(instance).get('/mana/oauth/authorize').query({ client_id: 'synthetic' })).status).toBe(503);
+  });
+
+  test('new public authorizer alias never exposes the legacy cohort when strict mode is configured', async () => {
+    process.env.PORTAL_STRICT_OAUTH_ENABLED = 'true';
+    process.env.PORTAL_STRICT_OAUTH_CONFIG = JSON.stringify({
+      version: 1,
+      webOrigin: 'https://synthetic.invalid',
+      clients: [{
+        clientId: 'synthetic-strict', issuer: 'https://synthetic.invalid', audience: 'urn:synthetic', redirectUri: 'https://product.invalid/callback', accessTtlSeconds: 300, familyTtlSeconds: 28800, maxRotations: 96,
+      }],
+    });
+    process.env.PORTAL_STRICT_OAUTH_SIGNING_KEY = 'synthetic-key-material-at-least-32-characters';
+    const previousRefresh = process.env.REFRESH_TOKEN_SECRET;
+    process.env.REFRESH_TOKEN_SECRET = 'synthetic-central-refresh-key-material';
+    try {
+      const instance = app();
+      expect((await request(instance).get('/mana/oauth/authorize').query({ client_id: 'legacy' })).status).toBe(404);
+      expect((await request(instance).get('/oauth/authorize').query({ client_id: 'legacy' })).status).toBe(200);
+    } finally {
+      if (previousRefresh === undefined) delete process.env.REFRESH_TOKEN_SECRET;
+      else process.env.REFRESH_TOKEN_SECRET = previousRefresh;
+    }
+  });
+});
