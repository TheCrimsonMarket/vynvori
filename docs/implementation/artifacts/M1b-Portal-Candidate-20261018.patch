index 00000000..bdd58563
--- /dev/null
+++ b/src/service/oauthStrictBootstrap.js
@@ -0,0 +1,35 @@
+import mongoose from 'mongoose';
+import { createStrictOAuthRuntime } from './oauthStrictRuntime';
+import { registerStrictOAuthRoutes } from '../routes/oauthStrictRoutes';
+
+// No database access or strict routes when the feature is absent/false.
+// No install, enrollment, index repair, secret generation or DDL at startup.
+export function initializeStrictOAuth(app, environment = process.env, authorization = null) {
+  const runtime = createStrictOAuthRuntime({
+    environment,
+    getDatabase: () => mongoose.connection.db,
+    getAuthorizationCodes: (db) => db.collection(mongoose.model('oauthAuthorizationCode').collection.name),
+    readClient: (clientId) => mongoose.model('oauthClient').findOne({ clientId }).select('clientId clientSecret active audience pkcePolicy redirectUris allowedGrants allowedScopes rateLimitPerHour').lean(),
+    readSubjectState: async (subject) => {
+      const user = await mongoose.model('userBN').findById(subject).select('_id tokenVersion').lean();
+      if (!user || !Number.isSafeInteger(user.tokenVersion) || user.tokenVersion < 0) return null;
+      return { active: true, tokenVersion: user.tokenVersion };
+    },
+    refreshSigningKey: environment.REFRESH_TOKEN_SECRET,
+  });
+  if (!runtime) return (_req, _res, next) => next();
+  registerStrictOAuthRoutes(app, runtime);
+  if (authorization && [authorization.loginRequired, authorization.get, authorization.post].every((handler) => typeof handler === 'function')) {
+    const enrolledOnly = (req, res, next) => {
+      res.set('Cache-Control', 'no-store');
+      if (!runtime.diagnostic.configurationValid) return res.status(503).json({ error: 'temporarily_unavailable' });
+      const clientId = (req.method === 'GET' ? req.query : req.body)?.client_id;
+      if (!runtime.isEnrolled(clientId)) return res.status(404).json({ error: 'invalid_client' });
+      return next();
+    };
+    app.route('/mana/oauth/authorize')
+      .get(enrolledOnly, authorization.loginRequired, runtime.authorizationGuard, authorization.get)
+      .post(enrolledOnly, authorization.loginRequired, runtime.authorizationGuard, authorization.post);
+  }
+  return runtime.authorizationGuard;
+}
