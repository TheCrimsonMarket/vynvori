@@ -0,0 +1,66 @@
+import crypto from 'crypto';
+import jwt from 'jsonwebtoken';
+
+// Installed only by an explicitly enabled strict runtime. Unknown clients retain
+// the legacy path; a strict client cannot obtain strict context through fallback.
+export function createStrictAuthorizationGuard({
+  resolvePolicy, readClient, readSubjectState, refreshSigningKey, webOrigin,
+} = {}) {
+  if (![resolvePolicy, readClient, readSubjectState].every((value) => typeof value === 'function')
+    || !refreshSigningKey || !webOrigin || new URL(webOrigin).origin !== webOrigin
+    || !webOrigin.startsWith('https://')) throw new TypeError('Strict authorization requires trusted central session adapters');
+  const key = Buffer.from(refreshSigningKey);
+  return async function strictAuthorizationGuard(req, res, next) {
+    try {
+      const parameters = req.method === 'GET' ? req.query : req.body;
+      const clientId = parameters?.client_id;
+      if (typeof clientId !== 'string') return next();
+      const policy = await resolvePolicy(clientId);
+      if (!policy) return next();
+      const fail = (status, code) => res.status(status).set('Cache-Control', 'no-store').json({ error: code });
+      const forwardedOrigin = req.get('X-OAuth-Request-Origin');
+      if (forwardedOrigin !== webOrigin || (req.get('Origin') && req.get('Origin') !== webOrigin)) return fail(403, 'invalid_request');
+      if (policy.clientId !== clientId || !policy.issuer || !policy.audience || policy.redirectUri !== parameters.redirect_uri
+        || (req.method === 'GET' && parameters.response_type !== 'code')
+        || (req.method === 'POST' && parameters.response_type !== undefined && parameters.response_type !== 'code')
+        || typeof parameters.state !== 'string'
+        || !/^[A-Za-z0-9_-]{32,256}$/.test(parameters.state)
+        || parameters.code_challenge_method !== 'S256' || typeof parameters.code_challenge !== 'string'
+        || !/^[A-Za-z0-9_-]{43}$/.test(parameters.code_challenge)) return fail(400, 'invalid_request');
+      const rawCookies = req.get('Cookie') || '';
+      if (rawCookies.split(';').filter((part) => part.trim().startsWith('refreshToken=')).length !== 1) return fail(401, 'login_required');
+      const refreshToken = req.cookies?.refreshToken;
+      if (typeof refreshToken !== 'string' || refreshToken.length > 16384) return fail(401, 'login_required');
+      let session;
+      try {
+        session = jwt.verify(refreshToken, key, { algorithms: ['HS256'] });
+      } catch {
+        return fail(401, 'login_required');
+      }
+      const subject = String(req.user?._id || '');
+      const now = Math.floor(Date.now() / 1000);
+      if (!/^[a-fA-F0-9]{24}$/.test(subject) || session._id !== subject
+        || !Number.isSafeInteger(session.tokenVersion) || session.tokenVersion < 0
+        || !Number.isSafeInteger(session.exp) || !Number.isSafeInteger(session.iat)
+        || session.exp <= now || session.iat > now || session.exp <= session.iat) return fail(401, 'login_required');
+      const client = await readClient(clientId);
+      const state = await readSubjectState(subject);
+      if (!client || client.clientId !== clientId || client.active !== true || client.audience !== policy.audience
+        || client.pkcePolicy !== 'required_s256' || !Array.isArray(client.redirectUris)
+        || !client.redirectUris.includes(policy.redirectUri) || state?.active !== true
+        || state.tokenVersion !== session.tokenVersion || Date.now() >= session.exp * 1000) return fail(401, 'login_required');
+      const context = Object.freeze({
+        issuer: policy.issuer,
+        audience: policy.audience,
+        clientId,
+        tokenVersion: session.tokenVersion,
+        authoritySessionHash: crypto.createHash('sha256').update(refreshToken).digest('hex'),
+      });
+      Object.defineProperty(req, 'strictAuthContext', { value: context, writable: false });
+      res.set('Cache-Control', 'no-store');
+      return next();
+    } catch {
+      return res.status(503).set('Cache-Control', 'no-store').json({ error: 'temporarily_unavailable' });
+    }
+  };
+}
diff --git a/src/service/oauthStrictBootstrap.js b/src/service/oauthStrictBootstrap.js
