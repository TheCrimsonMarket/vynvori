+import { MongoClient, ObjectId } from 'mongodb';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import { createStrictFamilyStore } from '../service/oauthStrictFamilyStore';
+
+const integration = process.env.PORTAL_STRICT_TEST_MONGO === '1' ? describe : describe.skip;
+
+integration('strict OAuth family persistence on disposable real MongoDB', () => {
+  let server;
+  let client;
+  let db;
+  let store;
+  let families;
+  let codes;
+  const clientId = 'synthetic-strict';
+  const subject = '507f1f77bcf86cd799439011';
+  const future = () => new Date(Date.now() + 60000);
+  const base = () => ({
+    _id: 'synthetic-family',
+    authorizationCodeId: 'synthetic-code-id',
+    clientId,
+    userId: subject,
+    issuer: 'urn:synthetic:authority',
+    audience: 'urn:synthetic:product',
+    scopes: ['profile'],
+    generation: 0,
+    state: 'active',
+    currentRefreshHash: 'synthetic-hash-old',
+    spentRefreshHashes: [],
+    refreshExpiresAt: future(),
+    currentAccessHash: 'synthetic-hash-access',
+    accessExpiresAt: future(),
+    createdAt: new Date(),
+    updatedAt: new Date(),
+  });
+
+  beforeAll(async () => {
+    if (!process.env.MONGOMS_SYSTEM_BINARY || process.env.MONGOMS_RUNTIME_DOWNLOAD !== 'false') {
+      throw new Error('Explicit existing MongoDB binary and downloads-disabled setting required');
+    }
+    server = await MongoMemoryServer.create({ binary: { systemBinary: process.env.MONGOMS_SYSTEM_BINARY }, instance: { dbName: 'm1b_synthetic_strict' } });
+    client = await MongoClient.connect(server.getUri());
+    db = client.db('m1b_synthetic_strict');
+    families = db.collection('oauth_strict_families_v1');
+    codes = db.collection('synthetic_authorization_codes');
+    store = createStrictFamilyStore({ families, authorizationCodes: codes });
+    await store.ensureIndexes();
+  });
+
+  beforeEach(async () => {
+    await families.deleteMany({});
+    await codes.deleteMany({});
+  });
+  afterAll(async () => {
+    if (client) await client.close();
+    if (server) await server.stop();
+  });
+
+  test('100 concurrent code claims have one business effect with exact callback and S256 binding', async () => {
+    const code = {
+      _id: new ObjectId(), code: 'synthetic-code', clientId, userId: new ObjectId(subject), scopes: ['profile'], redirectUri: 'https://synthetic.invalid/callback', codeChallenge: 'synthetic-challenge', codeChallengeMethod: 'S256', used: false, expiresAt: future(),
+    };
+    await codes.insertOne(code);
+    const claimed = await Promise.all(Array.from({ length: 100 }, () => store.consumeCode(code, new Date())));
+    expect(claimed.filter(Boolean)).toHaveLength(1);
+    expect((await codes.findOne({ _id: code._id })).used).toBe(true);
+  });
+
+  test.each(['redirectUri', 'codeChallenge', 'clientId', 'scopes'])('changed %s prevents code consumption', async (field) => {
+    const code = {
+      _id: new ObjectId(), code: 'synthetic-code', clientId, scopes: ['profile'], redirectUri: 'https://synthetic.invalid/callback', codeChallenge: 'synthetic-challenge', codeChallengeMethod: 'S256', used: false, expiresAt: future(),
+    };
+    await codes.insertOne(code);
+    const changed = { ...code, [field]: field === 'scopes' ? ['profile', 'email'] : 'changed' };
+    expect(await store.consumeCode(changed, new Date())).toBe(false);
+    expect((await codes.findOne({ _id: code._id })).used).toBe(false);
+  });
+
+  test('100 parallel refresh claims have one winner and hide old access while rotating', async () => {
+    await store.createFamily(base());
+    const claims = await Promise.all(Array.from({ length: 100 }, (_, i) => store.claimRotation({
+      familyId: 'synthetic-family', clientId, generation: 0, refreshHash: 'synthetic-hash-old', rotationId: `synthetic-rotation-${i}`, now: new Date(), maxRotations: 5,
+    })));
+    expect(claims.filter(Boolean)).toHaveLength(1);
+    expect(await store.readAccessRecord(clientId, 'synthetic-hash-access', new Date())).toBeNull();
+    const claim = claims.find(Boolean);
+    const committed = await store.completeRotation({
+      familyId: claim._id, clientId, generation: claim.generation, rotationId: claim.rotationId, refreshHash: 'synthetic-hash-new', accessHash: 'synthetic-new-access', accessExpiresAt: future(), now: new Date(),
+    });
+    expect(committed).toBe(true);
+    expect((await store.findRefreshFamily(clientId, 'synthetic-hash-old')).spentRefreshHashes).toContain('synthetic-hash-old');
+    expect(await store.readAccessRecord(clientId, 'synthetic-hash-access', new Date())).toBeNull();
+    expect(await store.readAccessRecord(clientId, 'synthetic-new-access', new Date())).toMatchObject({ userId: subject, clientId, revoked: false });
+  });
+
+  test('revocation fences a late refresh commit and keeps access denied', async () => {
+    await store.createFamily(base());
+    const claim = await store.claimRotation({
+      familyId: 'synthetic-family', clientId, generation: 0, refreshHash: 'synthetic-hash-old', rotationId: 'synthetic-rotation', now: new Date(), maxRotations: 5,
+    });
+    expect(await store.revokeFamily(clientId, claim._id, new Date())).toBe(true);
+    expect(await store.completeRotation({
+      familyId: claim._id, clientId, generation: claim.generation, rotationId: claim.rotationId, refreshHash: 'synthetic-hash-new', accessHash: 'synthetic-new-access', accessExpiresAt: future(), now: new Date(),
+    })).toBe(false);
+    expect((await families.findOne({ _id: claim._id })).state).toBe('revoked');
+  });
+
+  test('client ownership gates all reads, claims and revocation', async () => {
+    await store.createFamily(base());
+    expect(await store.findRefreshFamily('other', 'synthetic-hash-old')).toBeNull();
+    expect(await store.readAccessRecord('other', 'synthetic-hash-access', new Date())).toBeNull();
+    expect(await store.revokeFamily('other', 'synthetic-family', new Date())).toBe(false);
+    expect(await store.claimRotation({
+      familyId: 'synthetic-family', clientId: 'other', generation: 0, refreshHash: 'synthetic-hash-old', rotationId: 'other', now: new Date(), maxRotations: 5,
+    })).toBeNull();
+  });
+
+  test('unique code lineage prevents a second family for the same consumed code', async () => {
+    await store.createFamily(base());
+    await expect(store.createFamily({ ...base(), _id: 'another-family' })).rejects.toMatchObject({ code: 11000 });
+    expect(await families.countDocuments()).toBe(1);
+  });
+
+  test('expired families and exhausted rotation budgets fail closed', async () => {
+    await store.createFamily({ ...base(), refreshExpiresAt: new Date(0) });
+    expect(await store.readAccessRecord(clientId, 'synthetic-hash-access', new Date())).toBeNull();
+    expect(await store.claimRotation({
+      familyId: 'synthetic-family', clientId, generation: 0, refreshHash: 'synthetic-hash-old', rotationId: 'synthetic-rotation', now: new Date(), maxRotations: 5,
+    })).toBeNull();
+    await families.updateOne({ _id: 'synthetic-family' }, { $set: { refreshExpiresAt: future(), generation: 5 } });
+    expect(await store.claimRotation({
+      familyId: 'synthetic-family', clientId, generation: 5, refreshHash: 'synthetic-hash-old', rotationId: 'synthetic-rotation', now: new Date(), maxRotations: 5,
+    })).toBeNull();
+  });
+
+  test('revocation can match a prior refresh hash but cannot touch another client', async () => {
+    await store.createFamily({ ...base(), spentRefreshHashes: ['synthetic-spent-hash'] });
+    expect(await store.revokeByHash('other', 'synthetic-spent-hash', new Date())).toBe(false);
+    expect(await store.revokeByHash(clientId, 'synthetic-spent-hash', new Date())).toBe(true);
+    expect(await store.readAccessRecord(clientId, 'synthetic-hash-access', new Date())).toBeNull();
+  });
+
+  test('constructing a store never creates indexes and refuses legacy family collections', () => {
+    expect(() => createStrictFamilyStore({ families: db.collection('oauthaccesstokens'), authorizationCodes: codes })).toThrow();
+  });
+});
