+import express from 'express';
+
+// Mount before shared Portal parsers, only on strict prefixes when enabled.
+export function createStrictTransportPreflight() {
+  const parser = express.Router();
+  parser.use((req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    res.set('Pragma', 'no-cache');
+    if (!req.is('application/x-www-form-urlencoded')) return res.status(415).json({ error: 'invalid_request' });
+    return next();
+  });
+  parser.use(express.urlencoded({ extended: false, limit: '24kb', parameterLimit: 8 }));
+  parser.use((err, _req, res, next) => {
+    if (res.headersSent) return next(err);
+    return res.status(err?.type === 'entity.too.large' ? 413 : 400).json({ error: 'invalid_request' });
+  });
+  return parser;
+}
+
+// Browser authorization is proxied as JSON with central cookies, unlike the
+// form/Basic token transport. Apply its cap only to the new strict-only alias.
+export function createStrictAuthorizationPreflight() {
+  const parser = express.Router();
+  parser.use((req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (req.method !== 'POST') return next();
+    if (!req.is('application/json')) return res.status(415).json({ error: 'invalid_request' });
+    return next();
+  });
+  parser.use(express.json({ limit: '24kb' }));
+  parser.use((err, _req, res, next) => {
+    if (res.headersSent) return next(err);
+    return res.status(err?.type === 'entity.too.large' ? 413 : 400).json({ error: 'invalid_request' });
+  });
+  return parser;
+}
+
+// Additive route registrar, not mounted by existing Portal code.
+// Every credential and operation stays on a separately configured strict client.
+export function registerStrictOAuthRoutes(app, { resolveAuthority, allowRequest } = {}) {
+  if (typeof resolveAuthority !== 'function' || typeof allowRequest !== 'function') {
+    throw new TypeError('Strict routes require explicit authority and rate-limit adapters');
+  }
+  const router = express.Router();
+  router.use((_req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    res.set('Pragma', 'no-cache');
+    next();
+  });
