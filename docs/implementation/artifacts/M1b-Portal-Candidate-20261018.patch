+import express from 'express';
+import request from 'supertest';
+import mongoose from 'mongoose';
+import { initializeStrictOAuth } from '../service/oauthStrictBootstrap';
+
+jest.mock('mongoose', () => ({
+  __esModule: true,
+  default: { connection: { db: undefined }, model: jest.fn(() => { throw new Error('Unexpected model access'); }) },
+}));
+
+describe('strict Portal bootstrap preserves legacy default behavior', () => {
+  beforeEach(() => jest.clearAllMocks());
+  test('default-off bootstrap performs no model lookup and adds no endpoint', async () => {
+    const app = express();
+    const guard = initializeStrictOAuth(app, {});
+    app.get('/authorize', guard, (_req, res) => res.json({ legacy: true }));
+    expect((await request(app).get('/authorize')).body).toEqual({ legacy: true });
+    expect((await request(app).post('/oauth/strict/v1/token')).status).toBe(404);
+    expect(mongoose.model).not.toHaveBeenCalled();
+  });
+  test('malformed strict settings never crash legacy startup or touch models', async () => {
+    const app = express();
+    const guard = initializeStrictOAuth(app, { PORTAL_STRICT_OAUTH_ENABLED: 'true', PORTAL_STRICT_OAUTH_CONFIG: '{invalid' });
+    app.get('/authorize', guard, (_req, res) => res.json({ legacy: true }));
+    expect((await request(app).get('/authorize')).status).toBe(200);
+    expect(mongoose.model).not.toHaveBeenCalled();
+    const response = await request(app).post('/oauth/strict/v1/revoke').auth('synthetic', 'synthetic').type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(503);
+  });
+});
