+import crypto from 'crypto';
+import express from 'express';
+import cookieParser from 'cookie-parser';
+import jwt from 'jsonwebtoken';
+import request from 'supertest';
+import { MongoClient, ObjectId } from 'mongodb';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import { createStrictOAuthRuntime, prepareStrictOAuthStorage } from '../service/oauthStrictRuntime';
+import { registerStrictOAuthRoutes } from '../routes/oauthStrictRoutes';
+
+describe('strict runtime is default-off and isolated from legacy availability', () => {
+  test('disabled feature never touches configuration, secrets or database adapters', () => {
+    const getDatabase = jest.fn(() => { throw new Error('must not call'); });
+    expect(createStrictOAuthRuntime({ environment: {}, getDatabase })).toBeNull();
+    expect(getDatabase).not.toHaveBeenCalled();
+  });
+  test('invalid enabled configuration leaves legacy requests usable and strict requests unavailable', async () => {
+    const runtime = createStrictOAuthRuntime({ environment: { PORTAL_STRICT_OAUTH_ENABLED: 'true', PORTAL_STRICT_OAUTH_CONFIG: '{invalid' } });
+    const app = express();
+    app.get('/legacy', runtime.authorizationGuard, (_req, res) => res.json({ legacy: true }));
+    registerStrictOAuthRoutes(app, runtime);
+    expect((await request(app).get('/legacy')).body).toEqual({ legacy: true });
+    const response = await request(app).post('/oauth/strict/v1/revoke').auth('synthetic', 'synthetic').type('form')
+      .send({ token: 'synthetic' });
+    expect(response.status).toBe(503);
+    expect(response.body).toEqual({ error: 'temporarily_unavailable' });
+  });
+});
+
+const integration = process.env.PORTAL_STRICT_TEST_MONGO === '1' ? describe : describe.skip;
+integration('strict runtime readiness and rate limits on real disposable MongoDB', () => {
+  let server;
+  let connection;
+  let db;
+  let runtime;
+  let readClient;
+  const key = crypto.randomBytes(32);
+  const policy = {
+    clientId: 'synthetic-strict', issuer: 'https://synthetic.invalid', audience: 'urn:synthetic', redirectUri: 'https://product.invalid/callback', accessTtlSeconds: 300, familyTtlSeconds: 28800, maxRotations: 96,
+  };
+  const environment = { PORTAL_STRICT_OAUTH_ENABLED: 'true', PORTAL_STRICT_OAUTH_CONFIG: JSON.stringify({ version: 1, webOrigin: 'https://synthetic.invalid', clients: [policy] }), PORTAL_STRICT_OAUTH_SIGNING_KEY: key.toString('hex') };
+  const build = () => createStrictOAuthRuntime({
+    environment, getDatabase: () => db, getAuthorizationCodes: () => db.collection('synthetic_codes'), readClient, readSubjectState: async () => ({ active: true, tokenVersion: 0 }), refreshSigningKey: key,
+  });
+  beforeAll(async () => {
+    if (!process.env.MONGOMS_SYSTEM_BINARY || process.env.MONGOMS_RUNTIME_DOWNLOAD !== 'false') throw new Error('Explicit binary and no downloads required');
+    server = await MongoMemoryServer.create({ binary: { systemBinary: process.env.MONGOMS_SYSTEM_BINARY }, instance: { dbName: 'm1b_synthetic_runtime' } });
+    connection = await MongoClient.connect(server.getUri());
+    db = connection.db('m1b_synthetic_runtime');
+  });
+  beforeEach(async () => {
+    await db.dropDatabase();
+    readClient = jest.fn(async () => ({
+      clientId: policy.clientId, clientSecret: 'synthetic-secret', active: true, audience: policy.audience, pkcePolicy: 'required_s256', redirectUris: [policy.redirectUri], allowedGrants: ['authorization_code', 'refresh_token'], allowedScopes: ['profile'], rateLimitPerHour: 3,
+    }));
+    runtime = build();
+  });
+  afterAll(async () => {
+    if (connection) await connection.close();
+    if (server) await server.stop();
+  });
