+import AuthorizationCode from '../models/oauthAuthorizationCodeModel';
+
+jest.unmock('mongoose');
+
+describe('additive strict authorization-code schema', () => {
+  const input = () => ({
+    clientId: 'synthetic', userId: '507f1f77bcf86cd799439011', redirectUri: 'https://synthetic.invalid/callback', scopes: ['profile'],
+  });
+  test('legacy documents have no strict-context default', () => {
+    const document = new AuthorizationCode(input());
+    expect(document.validateSync()).toBeUndefined();
+    expect(document.toObject().strictContext).toBeUndefined();
+  });
+  test('strict context survives model serialization and requires complete fields', () => {
+    const strictContext = {
+      issuer: 'urn:synthetic', audience: 'urn:synthetic:product', clientId: 'synthetic', tokenVersion: 0, authoritySessionHash: 'a'.repeat(64),
+    };
+    const document = new AuthorizationCode({ ...input(), strictContext });
+    expect(document.validateSync()).toBeUndefined();
