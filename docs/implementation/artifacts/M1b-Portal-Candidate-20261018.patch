diff --git a/src/__tests__/oauth-legacy-compatibility.test.js b/src/__tests__/oauth-legacy-compatibility.test.js
new file mode 100644
index 00000000..3f356e21
--- /dev/null
+++ b/src/__tests__/oauth-legacy-compatibility.test.js
@@ -0,0 +1,74 @@
+// Characterization of existing behavior, not approval to reuse it for strict clients.
+import crypto from 'crypto';
+import jwt from 'jsonwebtoken';
+import { __models } from 'mongoose';
+import {
+  generateTokens, refreshAccessToken, verifyAccessToken, revokeToken,
+} from '../service/oauthService';
+
+jest.mock('mongoose', () => {
+  const models = {
+    oauthClient: { findOne: jest.fn() },
+    oauthAuthorizationCode: {},
+    oauthAccessToken: { create: jest.fn(), findOne: jest.fn() },
+    oauthRefreshToken: { create: jest.fn(), findOne: jest.fn() },
+    userBN: { findById: jest.fn() },
+    customer: {},
+  };
+  return { __esModule: true, __models: models, default: { model: (name) => models[name] || {} } };
+});
+
+describe('legacy OAuth compatibility baseline', () => {
+  const subject = '507f1f77bcf86cd799439011';
+  beforeEach(() => {
+    jest.resetAllMocks();
+    __models.userBN.findById.mockResolvedValue({ userName: 'Synthetic', displayName: 'Synthetic' });
+    __models.oauthAccessToken.create.mockResolvedValue({});
+    __models.oauthRefreshToken.create.mockResolvedValue({ token: 'synthetic-refresh' });
+  });
+
+  test.each([undefined, 'service.synthetic'])('preserves human token contract with audience %s', async (audience) => {
+    const result = await generateTokens(subject, 'synthetic-legacy', ['profile'], audience);
+    expect(Object.keys(result).sort()).toEqual(['access_token', 'expires_in', 'refresh_token', 'scope', 'token_type']);
+    const claims = jwt.verify(result.access_token, process.env.OAUTH_TOKEN_SECRET);
+    expect(claims.iss).toBeUndefined();
+    expect(claims.aud).toBe(audience);
+    expect(claims.exp - claims.iat).toBe(3600);
+    expect(claims).toMatchObject({
+      sub: subject, client_id: 'synthetic-legacy', type: 'access_token', scope: 'profile',
+    });
+  });
+
+  test('existing valid token without issuer or audience remains accepted by legacy verifier', async () => {
+    const token = jwt.sign({ sub: subject, client_id: 'synthetic-legacy', type: 'access_token' }, process.env.OAUTH_TOKEN_SECRET, { expiresIn: 120 });
+    __models.oauthAccessToken.findOne.mockResolvedValue({ isValid: () => true });
+    expect(await verifyAccessToken(token)).toMatchObject({ sub: subject });
+    expect(__models.oauthAccessToken.findOne).toHaveBeenCalledWith({ tokenHash: crypto.createHash('sha256').update(token).digest('hex') });
+  });
+
+  test.each(['revoked', 'missing', 'bad-signature', 'expired', 'wrong-type'])('legacy verifier still rejects %s', async (variant) => {
+    const token = jwt.sign({ sub: subject, type: variant === 'wrong-type' ? 'refresh_token' : 'access_token' }, variant === 'bad-signature' ? 'synthetic-wrong-key' : process.env.OAUTH_TOKEN_SECRET, { expiresIn: variant === 'expired' ? -1 : 120 });
+    __models.oauthAccessToken.findOne.mockResolvedValue(variant === 'missing' ? null : { isValid: () => variant !== 'revoked' });
+    expect(await verifyAccessToken(token)).toBeNull();
+  });
+
+  test('legacy refresh remains reusable and does not acquire one-use semantics', async () => {
+    const stored = {
+      userId: subject, scopes: ['profile'], isValid: () => true, use: jest.fn(), revoke: jest.fn(),
+    };
+    __models.oauthRefreshToken.findOne.mockResolvedValue(stored);
+    __models.oauthClient.findOne.mockReturnValue({ select: async () => ({ allowedGrants: ['authorization_code', 'refresh_token'], allowedScopes: ['profile'] }) });
+    expect((await refreshAccessToken('synthetic-old-refresh', 'synthetic-legacy')).refresh_token).toBe('synthetic-refresh');
+    expect((await refreshAccessToken('synthetic-old-refresh', 'synthetic-legacy')).refresh_token).toBe('synthetic-refresh');
+    expect(stored.use).toHaveBeenCalledTimes(2);
+    expect(stored.revoke).not.toHaveBeenCalled();
+  });
+
+  test('legacy revoke keeps its single-record behavior', async () => {
+    const stored = { revoke: jest.fn() };
+    __models.oauthRefreshToken.findOne.mockResolvedValue(stored);
+    expect(await revokeToken('synthetic-refresh', 'refresh_token')).toEqual({ success: true });
+    expect(stored.revoke).toHaveBeenCalledTimes(1);
+    expect(__models.oauthAccessToken.findOne).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/__tests__/oauth-strict-access-verifier.test.js b/src/__tests__/oauth-strict-access-verifier.test.js
new file mode 100644
index 00000000..24ddfb07
--- /dev/null
+++ b/src/__tests__/oauth-strict-access-verifier.test.js
@@ -0,0 +1,105 @@
+import crypto from 'crypto';
+import jwt from 'jsonwebtoken';
+import { createStrictAccessVerifier } from '../service/oauthStrictAccessVerifier';
+
+describe('isolated strict-client access verifier candidate', () => {
+  const signingKey = crypto.randomBytes(32);
+  const policy = {
+    issuer: 'urn:synthetic:authority', audience: 'urn:synthetic:vynvori', clientId: 'synthetic-strict', maxTokenAgeSeconds: 300,
+  };
+  const subject = '507f1f77bcf86cd799439011';
+  let readClient;
+  let readToken;
+  let verify;
+  const mint = (patch = {}, options = {}) => jwt.sign({
+    sub: subject, client_id: policy.clientId, iss: policy.issuer, aud: policy.audience, type: 'access_token', scope: 'profile', jti: crypto.randomUUID(), ...patch,
+  }, signingKey, { expiresIn: 120, ...options });
+  beforeEach(() => {
+    readClient = jest.fn(async () => ({
+      clientId: policy.clientId, active: true, strictIdentity: { enabled: true, issuer: policy.issuer, audience: policy.audience }, allowedGrants: ['authorization_code', 'refresh_token'], allowedScopes: ['profile'],
+    }));
+    readToken = jest.fn(async () => ({
+      userId: subject, clientId: policy.clientId, scopes: ['profile'], revoked: false, expiresAt: new Date(Date.now() + 120000),
+    }));
+    verify = createStrictAccessVerifier(policy, { signingKey, readClient, readToken });
+  });
+
+  test('returns only validated identity and binding, without credentials or profile data', async () => {
+    const token = mint({ email: 'synthetic@example.invalid', roles: ['admin'] });
+    const result = await verify(token);
+    expect(result).toEqual({
+      status: 'ok',
+      identity: {
+        issuer: policy.issuer, subject, clientId: policy.clientId, audience: policy.audience, expiresAt: expect.any(Number), verifiedAt: expect.any(Number),
+      },
+    });
+    expect(JSON.stringify(result)).not.toContain(token);
+    expect(JSON.stringify(result)).not.toContain('email');
+    expect(readClient).toHaveBeenCalledWith(policy.clientId);
+    expect(readToken).toHaveBeenCalledWith(crypto.createHash('sha256').update(token).digest('hex'));
+  });
+
+  test.each([
+    ['missing issuer', { iss: undefined }], ['wrong issuer', { iss: 'urn:other' }],
+    ['missing audience', { aud: undefined }], ['wrong audience', { aud: 'urn:other' }],
+    ['multiple audiences', { aud: [policy.audience, 'urn:other'] }],
+    ['wrong client', { client_id: 'other' }], ['missing client', { client_id: undefined }],
+    ['empty subject', { sub: '' }], ['service subject', { sub: 'service:synthetic' }],
+    ['wrong type', { type: 'refresh_token' }], ['missing jti', { jti: undefined }],
+    ['future issued-at', { iat: Math.floor(Date.now() / 1000) + 60 }],
+  ])('rejects %s before storage access', async (_name, patch) => {
+    expect(await verify(mint(patch))).toEqual({ status: 'unauthenticated' });
+    expect(readClient).not.toHaveBeenCalled();
+    expect(readToken).not.toHaveBeenCalled();
+  });
+
+  test.each([['expired', { expiresIn: -1 }], ['excess lifetime', { expiresIn: 1000 }], ['wrong algorithm', { algorithm: 'HS384' }], ['not active', { notBefore: 60 }], ['missing iat', { noTimestamp: true }]])('rejects %s token', async (_name, options) => {
+    expect(await verify(mint({}, options))).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('rejects missing expiry', async () => {
+    const token = jwt.sign({
+      sub: subject, client_id: policy.clientId, iss: policy.issuer, aud: policy.audience, type: 'access_token', scope: 'profile', jti: crypto.randomUUID(),
+    }, signingKey);
+    expect(await verify(token)).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('rejects forged signature and oversized/malformed input', async () => {
+    const forged = jwt.sign({ sub: subject }, crypto.randomBytes(32));
+    await Promise.all([forged, '', null, {}, 'x'.repeat(16385)].map(async (token) => {
+      expect(await verify(token)).toEqual({ status: 'unauthenticated' });
+    }));
+  });
+
+  test.each([
+    ['missing client', null], ['inactive', { active: false }], ['legacy downgrade', { strictIdentity: undefined }],
+    ['disabled strict policy', { strictIdentity: { enabled: false } }], ['changed scopes', { allowedScopes: [] }],
+    ['service client', { allowedGrants: ['client_credentials'] }],
+    ['changed issuer', { strictIdentity: { enabled: true, issuer: 'urn:other', audience: policy.audience } }],
+  ])('rejects %s registration', async (_name, patch) => {
+    const base = await readClient();
+    readClient.mockResolvedValue(patch === null ? null : { ...base, ...patch });
+    expect(await verify(mint())).toEqual({ status: 'unauthenticated' });
+  });
+
+  test.each([
+    ['missing', null], ['revoked', { revoked: true }], ['wrong subject', { userId: 'other' }],
+    ['wrong client', { clientId: 'other' }], ['expired record', { expiresAt: new Date(0) }],
+    ['scope mismatch', { scopes: ['profile', 'email'] }],
+  ])('rejects %s token record', async (_name, patch) => {
+    const base = await readToken();
+    readToken.mockResolvedValue(patch === null ? null : { ...base, ...patch });
+    expect(await verify(mint())).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('storage outage is unavailable and contains no raw exception or credentials', async () => {
+    readToken.mockRejectedValue(new Error('synthetic sensitive upstream body'));
+    expect(await verify(mint())).toEqual({ status: 'unavailable' });
+  });
+
+  test('misconfigured policy or adapters cannot construct an enabled verifier', () => {
+    expect(() => createStrictAccessVerifier({ ...policy, issuer: '' }, { signingKey, readClient, readToken })).toThrow();
+    expect(() => createStrictAccessVerifier(policy, { signingKey: '', readClient, readToken })).toThrow();
+    expect(() => createStrictAccessVerifier(policy, { signingKey, readClient: null, readToken })).toThrow();
+  });
+});
diff --git a/src/__tests__/oauth-strict-authority.test.js b/src/__tests__/oauth-strict-authority.test.js
new file mode 100644
index 00000000..9bf000c0
--- /dev/null
+++ b/src/__tests__/oauth-strict-authority.test.js
@@ -0,0 +1,226 @@
+import crypto from 'crypto';
+import { MongoClient, ObjectId } from 'mongodb';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import jwt from 'jsonwebtoken';
+import { createStrictFamilyStore } from '../service/oauthStrictFamilyStore';
+import { createStrictAuthority } from '../service/oauthStrictAuthority';
+
+const integration = process.env.PORTAL_STRICT_TEST_MONGO === '1' ? describe : describe.skip;
+
+integration('isolated strict authority with real JWT and disposable MongoDB', () => {
+  let server;
+  let connection;
+  let families;
+  let codes;
+  let store;
+  let authority;
+  let registration;
+  let readSubjectState;
+  const subject = '507f1f77bcf86cd799439011';
+  const secret = crypto.randomBytes(32).toString('hex');
+  const signingKey = crypto.randomBytes(32);
+  const policy = {
+    issuer: 'urn:synthetic:authority', audience: 'urn:synthetic:product', clientId: 'synthetic-strict', redirectUri: 'https://synthetic.invalid/auth/callback', accessTtlSeconds: 120, familyTtlSeconds: 600, maxRotations: 5,
+  };
+
+  beforeAll(async () => {
+    if (!process.env.MONGOMS_SYSTEM_BINARY || process.env.MONGOMS_RUNTIME_DOWNLOAD !== 'false') throw new Error('Explicit existing binary and no downloads required');
+    server = await MongoMemoryServer.create({ binary: { systemBinary: process.env.MONGOMS_SYSTEM_BINARY }, instance: { dbName: 'm1b_synthetic_authority' } });
+    connection = await MongoClient.connect(server.getUri());
+    const db = connection.db('m1b_synthetic_authority');
+    families = db.collection('oauth_strict_families_v1');
+    codes = db.collection('synthetic_authorization_codes');
+  });
+  beforeEach(async () => {
+    await families.deleteMany({});
+    await codes.deleteMany({});
+    store = createStrictFamilyStore({ families, authorizationCodes: codes });
+    await store.ensureIndexes();
+    registration = {
+      clientId: policy.clientId, clientSecret: secret, active: true, audience: policy.audience, strictIdentity: { enabled: true, issuer: policy.issuer, audience: policy.audience }, pkcePolicy: 'required_s256', redirectUris: [policy.redirectUri], allowedGrants: ['authorization_code', 'refresh_token'], allowedScopes: ['profile'],
+    };
+    readSubjectState = jest.fn(async () => ({ active: true, tokenVersion: 0 }));
+    authority = createStrictAuthority(policy, {
+      signingKey, readClient: async () => registration, readSubjectState, store,
+    });
+  });
+  afterAll(async () => {
+    if (connection) await connection.close();
+    if (server) await server.stop();
+  });
+
+  async function input(patch = {}) {
+    const verifier = crypto.randomBytes(32).toString('base64url');
+    const code = crypto.randomBytes(32).toString('hex');
+    await codes.insertOne({
+      _id: new ObjectId(),
+      code,
+      clientId: policy.clientId,
+      userId: new ObjectId(subject),
+      scopes: ['profile'],
+      redirectUri: policy.redirectUri,
+      codeChallenge: crypto.createHash('sha256').update(verifier).digest('base64url'),
+      codeChallengeMethod: 'S256',
+      strictContext: {
+        issuer: policy.issuer, audience: policy.audience, clientId: policy.clientId, tokenVersion: 0,
+      },
+      used: false,
+      expiresAt: new Date(Date.now() + 60000),
+      ...patch,
+    });
+    return {
+      clientSecret: secret, code, codeVerifier: verifier, redirectUri: policy.redirectUri,
+    };
+  }
+  async function issued() {
+    const result = await authority.exchange(await input());
+    expect(result.status).toBe('ok');
+    return result.tokens;
+  }
+
+  test('strict code exchange creates one private family and correctly bound token pair', async () => {
+    const tokens = await issued();
+    const claims = jwt.verify(tokens.access_token, signingKey, { issuer: policy.issuer, audience: policy.audience, algorithms: ['HS256'] });
+    expect(claims).toMatchObject({
+      sub: subject, client_id: policy.clientId, type: 'access_token', generation: 0,
+    });
+    expect(claims.exp - claims.iat).toBe(120);
+    expect(await authority.introspect({ clientSecret: secret, token: tokens.access_token })).toMatchObject({ status: 'ok', identity: { issuer: policy.issuer, subject, clientId: policy.clientId } });
+    const records = await families.find({}).toArray();
+    expect(records).toHaveLength(1);
+    expect(JSON.stringify(records)).not.toContain(tokens.access_token);
+    expect(JSON.stringify(records)).not.toContain(tokens.refresh_token);
+    expect(JSON.stringify(records)).not.toContain(secret);
+  });
+
+  test.each(['wrong-secret', 'wrong-callback', 'wrong-verifier', 'missing-verifier'])('rejects %s without consuming code', async (variant) => {
+    const request = await input();
+    if (variant === 'wrong-secret') request.clientSecret = 'wrong';
+    if (variant === 'wrong-callback') request.redirectUri = 'https://other.invalid/callback';
+    if (variant === 'wrong-verifier') request.codeVerifier = crypto.randomBytes(32).toString('base64url');
+    if (variant === 'missing-verifier') delete request.codeVerifier;
+    expect(await authority.exchange(request)).toEqual({ status: 'unauthenticated' });
+    expect((await codes.findOne({ code: request.code })).used).toBe(false);
+    expect(await families.countDocuments()).toBe(0);
+  });
+
+  test.each([{ scopes: ['profile', 'email'] }, { codeChallengeMethod: 'plain' }, { expiresAt: new Date(0) }, { used: true }])('rejects invalid code policy %j', async (patch) => {
+    expect(await authority.exchange(await input(patch))).toEqual({ status: 'unauthenticated' });
+    expect(await families.countDocuments()).toBe(0);
+  });
+
+  test('100 simultaneous exchanges have one family/token response', async () => {
+    const request = await input();
+    const results = await Promise.all(Array.from({ length: 100 }, () => authority.exchange(request)));
+    expect(results.filter((result) => result.status === 'ok')).toHaveLength(1);
+    expect(await families.countDocuments()).toBe(1);
+  });
+
+  test('refresh rotates once, invalidates old access and detects old-refresh replay', async () => {
+    const oldTokens = await issued();
+    const refreshed = await authority.refresh({ clientSecret: secret, refreshToken: oldTokens.refresh_token });
+    expect(refreshed.status).toBe('ok');
+    expect(refreshed.tokens.refresh_token).not.toBe(oldTokens.refresh_token);
+    expect(await authority.introspect({ clientSecret: secret, token: oldTokens.access_token })).toEqual({ status: 'unauthenticated' });
+    expect((await authority.introspect({ clientSecret: secret, token: refreshed.tokens.access_token })).status).toBe('ok');
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: oldTokens.refresh_token })).toEqual({ status: 'reauth_required' });
+    expect(await authority.introspect({ clientSecret: secret, token: refreshed.tokens.access_token })).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('100 parallel refreshes commit at most one rotation', async () => {
+    const tokens = await issued();
+    const results = await Promise.all(Array.from({ length: 100 }, () => authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })));
+    expect(results.filter((result) => result.status === 'ok')).toHaveLength(1);
+    expect((await families.findOne({})).generation).toBe(1);
+  });
+
+  test('revoke accepts refresh/access tokens and does not reveal unknown token existence', async () => {
+    const tokens = await issued();
+    expect(await authority.revoke({ clientSecret: secret, token: 'unknown-synthetic' })).toEqual({ status: 'ok' });
+    expect(await authority.revoke({ clientSecret: secret, token: tokens.access_token })).toEqual({ status: 'ok' });
+    expect(await authority.introspect({ clientSecret: secret, token: tokens.access_token })).toEqual({ status: 'unauthenticated' });
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('wrong client credentials cannot introspect, refresh or revoke a family', async () => {
+    const tokens = await issued();
+    expect(await authority.introspect({ clientSecret: 'wrong', token: tokens.access_token })).toEqual({ status: 'unauthenticated' });
+    expect(await authority.refresh({ clientSecret: 'wrong', refreshToken: tokens.refresh_token })).toEqual({ status: 'unauthenticated' });
+    expect(await authority.revoke({ clientSecret: 'wrong', token: tokens.refresh_token })).toEqual({ status: 'unauthenticated' });
+    expect((await authority.introspect({ clientSecret: secret, token: tokens.access_token })).status).toBe('ok');
+  });
+
+  test('inactive subject or removed client enrollment denies every strict operation', async () => {
+    const tokens = await issued();
+    readSubjectState.mockResolvedValue(false);
+    expect(await authority.introspect({ clientSecret: secret, token: tokens.access_token })).toEqual({ status: 'unauthenticated' });
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toEqual({ status: 'unauthenticated' });
+    registration.strictIdentity.enabled = false;
+    expect(await authority.exchange(await input())).toEqual({ status: 'unauthenticated' });
+  });
+
+  test('lost initial write acknowledgement reports unknown and cannot re-exchange the code', async () => {
+    const create = store.createFamily;
+    store.createFamily = async (record) => { await create(record); throw new Error('synthetic-lost-ack'); };
+    const request = await input();
+    expect(await authority.exchange(request)).toMatchObject({ status: 'outcome_unknown', operationId: expect.any(String) });
+    expect(await authority.exchange(request)).toEqual({ status: 'unauthenticated' });
+    expect(await families.countDocuments()).toBe(1);
+  });
+
+  test('lost rotation acknowledgement is unknown; old refresh replay never mints another pair', async () => {
+    const tokens = await issued();
+    const complete = store.completeRotation;
+    store.completeRotation = async (request) => { await complete(request); throw new Error('synthetic-lost-ack'); };
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toMatchObject({ status: 'outcome_unknown' });
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toEqual({ status: 'reauth_required' });
+    expect((await families.findOne({})).generation).toBe(1);
+  });
+
+  test('revocation during refresh prevents late token issuance', async () => {
+    const tokens = await issued();
+    const complete = store.completeRotation;
+    store.completeRotation = async (request) => { await store.revokeFamily(policy.clientId, request.familyId, new Date()); return complete(request); };
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toEqual({ status: 'reauth_required' });
+    expect((await families.findOne({})).state).toBe('revoked');
+  });
+
+  test('revocation storage failure is unavailable rather than a false successful logout', async () => {
+    store.revokeByHash = async () => { throw new Error('synthetic-private-error'); };
+    expect(await authority.revoke({ clientSecret: secret, token: 'unknown-synthetic' })).toEqual({ status: 'unavailable' });
+  });
+
+  test('code issued before central token-version revocation cannot be exchanged', async () => {
+    const request = await input();
+    readSubjectState.mockResolvedValue({ active: true, tokenVersion: 1 });
+    expect(await authority.exchange(request)).toEqual({ status: 'unauthenticated' });
+    expect((await codes.findOne({ code: request.code })).used).toBe(false);
+  });
+
+  test('central token-version revocation denies existing access and refresh', async () => {
+    const tokens = await issued();
+    readSubjectState.mockResolvedValue({ active: true, tokenVersion: 1 });
+    expect(await authority.introspect({ clientSecret: secret, token: tokens.access_token })).toEqual({ status: 'unauthenticated' });
+    expect(await authority.refresh({ clientSecret: secret, refreshToken: tokens.refresh_token })).toEqual({ status: 'unauthenticated' });
+  });
+
+  test.each([
+    undefined,
+    { issuer: policy.issuer, audience: policy.audience, clientId: policy.clientId },
+    {
+      issuer: 'urn:other', audience: policy.audience, clientId: policy.clientId, tokenVersion: 0,
+    },
+  ])('missing or wrong strict authorization context fails closed: %j', async (strictContext) => {
+    expect(await authority.exchange(await input({ strictContext }))).toEqual({ status: 'unauthenticated' });
+    expect(await families.countDocuments()).toBe(0);
+  });
+
+  test('configuration needs explicit policy values, exact callback and a strong authority-only key', () => {
+    const deps = {
+      signingKey, readClient: async () => registration, readSubjectState, store,
+    };
+    expect(() => createStrictAuthority({ ...policy, accessTtlSeconds: undefined }, deps)).toThrow();
+    expect(() => createStrictAuthority({ ...policy, redirectUri: 'http://synthetic.invalid/callback' }, deps)).toThrow();
+    expect(() => createStrictAuthority(policy, { ...deps, signingKey: 'short' })).toThrow();
+  });
+});
diff --git a/src/__tests__/oauth-strict-authorization-guard.test.js b/src/__tests__/oauth-strict-authorization-guard.test.js
new file mode 100644
index 00000000..2e7bee6d
--- /dev/null
+++ b/src/__tests__/oauth-strict-authorization-guard.test.js
@@ -0,0 +1,106 @@
+import crypto from 'crypto';
+import express from 'express';
+import cookieParser from 'cookie-parser';
+import request from 'supertest';
+import jwt from 'jsonwebtoken';
+import { createStrictAuthorizationGuard } from '../service/oauthStrictAuthorizationGuard';
+
+describe('strict authorization binds a current central session to code context', () => {
+  const key = crypto.randomBytes(32);
+  const subject = '507f1f77bcf86cd799439011';
+  const origin = 'https://synthetic.invalid';
+  const policy = {
+    clientId: 'synthetic-strict', issuer: origin, audience: 'urn:synthetic:product', redirectUri: 'https://product.invalid/callback',
+  };
+  const parameters = {
+    client_id: policy.clientId, redirect_uri: policy.redirectUri, response_type: 'code', state: crypto.randomBytes(32).toString('base64url'), code_challenge: crypto.randomBytes(32).toString('base64url'), code_challenge_method: 'S256',
+  };
+  let app;
+  let readSubjectState;
+  let readClient;
+  const mint = (patch = {}, options = {}) => jwt.sign({ _id: subject, tokenVersion: 0, ...patch }, key, { expiresIn: 300, ...options });
+  beforeEach(() => {
+    readSubjectState = jest.fn(async () => ({ active: true, tokenVersion: 0 }));
+    readClient = jest.fn(async () => ({
+      clientId: policy.clientId, active: true, audience: policy.audience, pkcePolicy: 'required_s256', redirectUris: [policy.redirectUri],
+    }));
+    app = express();
+    app.use(cookieParser());
+    app.use(express.json());
+    app.use((req, _res, next) => { req.user = { _id: subject }; next(); });
+    const guard = createStrictAuthorizationGuard({
+      resolvePolicy: async (id) => (id === policy.clientId ? policy : null), readClient, readSubjectState, refreshSigningKey: key, webOrigin: origin,
+    });
+    const handler = (req, res) => res.json({ context: req.strictAuthContext || null });
+    app.get('/authorize', guard, handler);
+    app.post('/authorize', guard, handler);
+  });
+  const get = (token = mint(), query = parameters) => request(app).get('/authorize').query(query).set('X-OAuth-Request-Origin', origin)
+    .set('Cookie', `refreshToken=${token}`);
+
+  test('creates immutable server context from verified refresh and current version', async () => {
+    const token = mint();
+    const response = await get(token);
+    expect(response.status).toBe(200);
+    expect(response.body.context).toEqual({
+      issuer: policy.issuer, audience: policy.audience, clientId: policy.clientId, tokenVersion: 0, authoritySessionHash: crypto.createHash('sha256').update(token).digest('hex'),
+    });
+    expect(JSON.stringify(response.body)).not.toContain(token);
+  });
+
+  test('legacy clients bypass strict dependencies and preserve their authorization path', async () => {
+    const response = await request(app).get('/authorize').query({ client_id: 'synthetic-legacy' });
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({ context: null });
+    expect(readSubjectState).not.toHaveBeenCalled();
+    expect(readClient).not.toHaveBeenCalled();
+  });
+
+  test.each([{ _id: 'other' }, { tokenVersion: 1 }, { tokenVersion: undefined }])('denies stale or mismatched central credentials: %j', async (claims) => {
+    expect((await get(mint(claims))).status).toBe(401);
+  });
+
+  test('central database version revocation denies an otherwise valid cookie', async () => {
+    readSubjectState.mockResolvedValue({ active: true, tokenVersion: 1 });
+    expect((await get()).status).toBe(401);
+  });
+
+  test.each([{ expiresIn: -1 }, { notBefore: 300 }, { algorithm: 'HS384' }, { noTimestamp: true }])('rejects invalid refresh token options %j', async (options) => {
+    expect((await get(mint({}, options))).status).toBe(401);
+  });
+
+  test.each([{ redirect_uri: 'https://other.invalid/callback' }, { code_challenge_method: 'plain' }, { state: '' }, { code_challenge: '' }])('rejects invalid transaction parameters %j', async (patch) => {
+    expect((await get(mint(), { ...parameters, ...patch })).status).toBe(400);
+  });
+
+  test('requires explicit same-origin proxy provenance and rejects hostile browser origin', async () => {
+    expect((await get().set('Origin', 'https://other.invalid')).status).toBe(403);
+    expect((await request(app).get('/authorize').query(parameters).set('Cookie', `refreshToken=${mint()}`)).status).toBe(403);
+  });
+
+  test('duplicate refresh cookies cannot choose an ambiguous session', async () => {
+    const token = mint();
+    expect((await get(token).set('Cookie', `refreshToken=${token}; refreshToken=${token}`)).status).toBe(401);
+  });
+
+  test('browser cannot replace server authorization context through a POST body', async () => {
+    const response = await request(app).post('/authorize').set('X-OAuth-Request-Origin', origin).set('Cookie', `refreshToken=${mint()}`)
+      .send({ ...parameters, strictAuthContext: { tokenVersion: 99 } });
+    expect(response.status).toBe(200);
+    expect(response.body.context.tokenVersion).toBe(0);
+  });
+
+  test('established consent POST omits response_type but cannot request another response type', async () => {
+    const { response_type: responseType, ...consent } = parameters;
+    expect(responseType).toBe('code');
+    const post = (body) => request(app).post('/authorize').set('X-OAuth-Request-Origin', origin).set('Cookie', `refreshToken=${mint()}`)
+      .send(body);
+    expect((await post({ ...consent, approved: true })).status).toBe(200);
+    expect((await post({ ...consent, response_type: 'token', approved: true })).status).toBe(400);
+  });
+
+  test('central state outage fails closed with a sanitized error', async () => {
+    readSubjectState.mockRejectedValue(new Error('synthetic-private-error'));
+    expect((await get()).body).toEqual({ error: 'temporarily_unavailable' });
+  });
+});
