+import crypto from 'crypto';
+import jwt from 'jsonwebtoken';
+
+// Candidate authority-side primitive only. No route or legacy verifier imports it.
+// Dependencies and expected binding must come from trusted server configuration.
+export function createStrictAccessVerifier(policy, { signingKey, readClient, readToken } = {}) {
+  const validString = (value) => typeof value === 'string' && value.length > 0 && value.trim() === value;
+  if (!policy || ![policy.issuer, policy.audience, policy.clientId].every(validString)
+    || !Number.isSafeInteger(policy.maxTokenAgeSeconds) || policy.maxTokenAgeSeconds <= 0
+    || (!Buffer.isBuffer(signingKey) && typeof signingKey !== 'string') || !signingKey.length
+    || typeof readClient !== 'function' || typeof readToken !== 'function') {
+    throw new TypeError('Strict identity verifier requires complete trusted configuration');
+  }
+  // Copy the policy so mutation of a shared configuration object cannot change a verifier.
+  const {
+    issuer, audience, clientId, maxTokenAgeSeconds,
+  } = policy;
+  const key = Buffer.from(signingKey);
+  const deny = () => ({ status: 'unauthenticated' });
+
+  return async function verifyStrictAccess(token) {
+    if (typeof token !== 'string' || !token.length || token.length > 16384) return deny();
+    let claims;
+    try {
+      claims = jwt.verify(token, key, {
+        algorithms: ['HS256'], issuer, audience, maxAge: maxTokenAgeSeconds,
+      });
+    } catch {
+      return deny();
+    }
+    const now = Math.floor(Date.now() / 1000);
+    if (!claims || typeof claims !== 'object' || claims.iss !== issuer || claims.aud !== audience
+      || claims.client_id !== clientId || claims.type !== 'access_token'
+      || !validString(claims.sub) || !/^[a-fA-F0-9]{24}$/.test(claims.sub)
+      || !validString(claims.jti) || !validString(claims.scope)
+      || !Number.isSafeInteger(claims.iat) || !Number.isSafeInteger(claims.exp)
+      || claims.iat > now || claims.exp <= now || claims.exp <= claims.iat
+      || claims.exp - claims.iat > maxTokenAgeSeconds) return deny();
+    const scopes = claims.scope.split(' ');
+    if (scopes.some((scope) => !scope) || new Set(scopes).size !== scopes.length) return deny();
+
+    try {
+      const client = await readClient(clientId);
+      const strict = client?.strictIdentity;
+      const grants = client?.allowedGrants;
+      if (!client || client.clientId !== clientId || client.active !== true
+        || strict?.enabled !== true || strict.issuer !== issuer || strict.audience !== audience
+        || !Array.isArray(grants) || grants.length !== 2
+        || !grants.includes('authorization_code') || !grants.includes('refresh_token')
+        || !Array.isArray(client.allowedScopes)
+        || scopes.some((scope) => !client.allowedScopes.includes(scope))) return deny();
+
+      const hash = crypto.createHash('sha256').update(token).digest('hex');
+      const record = await readToken(hash);
+      const expiry = record?.expiresAt instanceof Date ? record.expiresAt.getTime() : NaN;
+      const currentTime = Date.now();
+      if (!record || record.revoked !== false || record.revokedAt
+        || record.clientId !== clientId || String(record.userId) !== claims.sub
+        || !Number.isFinite(expiry) || expiry <= currentTime || claims.exp * 1000 <= currentTime
+        || currentTime >= (claims.iat + maxTokenAgeSeconds) * 1000
+        || !Array.isArray(record.scopes) || record.scopes.length !== scopes.length
+        || new Set(record.scopes).size !== scopes.length
+        || scopes.some((scope) => !record.scopes.includes(scope))) return deny();
+
+      return {
+        status: 'ok',
+        identity: {
+          issuer,
+          subject: claims.sub,
+          clientId,
+          audience,
+          expiresAt: Math.min(claims.exp * 1000, expiry),
+          verifiedAt: currentTime,
+        },
+      };
+    } catch {
+      // Never expose token, raw database errors or profile/role data.
+      return { status: 'unavailable' };
+    }
+  };
+}
