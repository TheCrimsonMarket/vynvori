+  const text = (value) => typeof value === 'string' && value.length > 0 && value.trim() === value;
+  const positiveInteger = (value) => Number.isSafeInteger(value) && value > 0 && Number.isSafeInteger(value * 1000);
+  if (!policy || ![policy.issuer, policy.audience, policy.clientId, policy.redirectUri].every(text)
+    || ![policy.accessTtlSeconds, policy.familyTtlSeconds, policy.maxRotations].every(positiveInteger)
