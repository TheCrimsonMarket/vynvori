+  if (!existing.has(RATE_COLLECTION)) await db.createCollection(RATE_COLLECTION);
+  const store = createStrictFamilyStore({ families: db.collection(FAMILY_COLLECTION), authorizationCodes: db.collection('unused_operator_adapter') });
+  await store.ensureIndexes();
