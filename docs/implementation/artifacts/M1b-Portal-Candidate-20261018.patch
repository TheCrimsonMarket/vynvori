@@ -0,0 +1,158 @@
+// Optional two-repository integration. Next request context is stubbed; the
+// actual core handlers and Portal controllers/services/HTTP/MongoDB are exercised.
+import crypto from 'crypto';
+import path from 'path';
+import express from 'express';
+import cookieParser from 'cookie-parser';
+import request from 'supertest';
+import jwt from 'jsonwebtoken';
+import mongoose from 'mongoose';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import { prepareStrictOAuthStorage } from '../service/oauthStrictRuntime';
+import { createStrictAuthorizationPreflight, createStrictTransportPreflight } from '../routes/oauthStrictRoutes';
+
+jest.unmock('mongoose');
+jest.mock('../service/userService', () => ({ __esModule: true }));
+jest.mock('../controllers/oauthDeveloperController', () => new Proxy({ __esModule: true }, { get: (_target, name) => (name === '__esModule' ? true : (_req, res) => res.sendStatus(404)) }));
+jest.mock('../controllers/oauthServiceClientController', () => new Proxy({ __esModule: true }, { get: (_target, name) => (name === '__esModule' ? true : (_req, res) => res.sendStatus(404)) }));
+
+const integration = process.env.PORTAL_STRICT_TEST_MONGO === '1' && process.env.CORE_STRICT_PROXY_SOURCE_ROOT ? describe : describe.skip;
+integration('actual core authorizer proxy interoperates with strict Portal controllers', () => {
+  let server;
+  let app;
+  let core;
+  let accessCookie;
+  let refreshCookie;
+  let log;
+  let Client;
+  let User;
+  let Code;
+  const origin = 'https://central.synthetic.invalid';
+  const callback = 'https://product.synthetic.invalid/auth/tcm/callback';
+  const subject = '507f1f77bcf86cd799439011';
+  const clientId = 'synthetic-core-portal';
+  const secret = crypto.randomBytes(32).toString('hex');
+  const accessKey = crypto.randomBytes(32);
+  const refreshKey = crypto.randomBytes(32).toString('hex');
+  const state = crypto.randomBytes(32).toString('base64url');
+  const verifier = crypto.randomBytes(32).toString('base64url');
+  const keys = ['PORTAL_STRICT_OAUTH_ENABLED', 'PORTAL_STRICT_OAUTH_CONFIG', 'PORTAL_STRICT_OAUTH_SIGNING_KEY', 'REFRESH_TOKEN_SECRET', 'CORE_STRICT_OAUTH_CLIENT_IDS', 'CORE_STRICT_OAUTH_WEB_ORIGIN', 'CORE_STRICT_OAUTH_API_BASE_URL'];
+  const original = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+
+  beforeAll(async () => {
+    if (!process.env.MONGOMS_SYSTEM_BINARY || process.env.MONGOMS_RUNTIME_DOWNLOAD !== 'false') throw new Error('Explicit cached binary and downloads disabled required');
+    server = await MongoMemoryServer.create({ binary: { systemBinary: process.env.MONGOMS_SYSTEM_BINARY }, instance: { dbName: 'm1b_core_portal_synthetic' } });
+    // Legacy schemas contain pre-existing boolean index directions rejected by
+    // MongoDB. This fixture does not claim to validate/repair legacy auto-DDL.
+    await mongoose.connect(server.getUri(), { dbName: 'm1b_core_portal_synthetic', autoIndex: false, autoCreate: false });
+    User = mongoose.model('userBN', new mongoose.Schema({ userName: String, tokenVersion: Number }));
+    ['customer', 'DiscordGuildMembership', 'DiscordGuildSync'].forEach((name) => mongoose.model(name, new mongoose.Schema({})));
+    Client = jest.requireActual('../models/oauthClientModel').default;
+    Code = jest.requireActual('../models/oauthAuthorizationCodeModel').default;
+    jest.requireActual('../models/oauthAccessTokenModel');
+    jest.requireActual('../models/oauthRefreshTokenModel');
+    await Client.init();
+    await Code.init();
+    await Client.collection.createIndex({ clientId: 1 }, { unique: true });
+    await Code.collection.createIndex({ code: 1 }, { unique: true });
+    process.env.PORTAL_STRICT_OAUTH_ENABLED = 'true';
+    process.env.PORTAL_STRICT_OAUTH_CONFIG = JSON.stringify({
+      version: 1,
+      webOrigin: origin,
+      clients: [{
+        clientId, issuer: origin, audience: 'urn:synthetic:product', redirectUri: callback, accessTtlSeconds: 300, familyTtlSeconds: 28800, maxRotations: 96,
+      }],
+    });
+    process.env.PORTAL_STRICT_OAUTH_SIGNING_KEY = crypto.randomBytes(32).toString('hex');
+    process.env.REFRESH_TOKEN_SECRET = refreshKey;
+    process.env.CORE_STRICT_OAUTH_CLIENT_IDS = JSON.stringify([clientId]);
+    process.env.CORE_STRICT_OAUTH_WEB_ORIGIN = origin;
+    process.env.CORE_STRICT_OAUTH_API_BASE_URL = `${origin}/mana`;
+    await prepareStrictOAuthStorage(mongoose.connection.db, { expectedDatabaseName: 'm1b_core_portal_synthetic', acknowledgeAdditiveOnly: true });
+    app = express();
+    app.use(cookieParser());
+    app.use('/mana/oauth/authorize', createStrictAuthorizationPreflight());
+    app.use(['/oauth/strict/v1', '/mana/oauth/strict/v1'], createStrictTransportPreflight());
+    app.use(express.json());
+    app.use(express.urlencoded({ extended: true }));
+    app.use((req, _res, next) => {
+      try { req.user = jwt.verify(req.cookies.authToken || '', accessKey); } catch { req.user = undefined; }
+      next();
+    });
+    jest.requireActual('../routes/oauthRoutes').default(app, { loginRequired: (req, res, next) => (req.user ? next() : res.status(401).json({ error: 'login_required' })) });
+    const coreRoot = process.env.CORE_STRICT_PROXY_SOURCE_ROOT;
+    jest.doMock(require.resolve('next/server', { paths: [coreRoot] }), () => ({ NextResponse: { json: (body, options = {}) => ({ body, status: options.status || 200 }) } }));
+    jest.doMock(require.resolve('next/headers', { paths: [coreRoot] }), () => ({ cookies: () => ({ get: (name) => ({ value: name === 'authToken' ? accessCookie : refreshCookie }) }) }));
+    const bridge = async (method, url, body, options) => {
+      if (url !== `${origin}/mana/oauth/authorize` || options.maxRedirects !== 0) throw new Error('Unexpected proxy target');
+      let operation = request(app)[method]('/mana/oauth/authorize').set(options.headers).redirects(0);
+      if (method === 'get') operation = operation.query(Object.fromEntries(Object.entries(options.params).filter(([, value]) => value != null)));
+      else operation = operation.send(body);
+      const response = await operation;
+      if (!options.validateStatus(response.status)) {
+        const error = new Error('Synthetic upstream failure');
+        error.response = { status: response.status, data: response.body };
+        throw error;
+      }
+      return { status: response.status, data: response.body };
+    };
+    jest.doMock(require.resolve('axios', { paths: [coreRoot] }), () => ({ get: (url, options) => bridge('get', url, null, options), post: (url, body, options) => bridge('post', url, body, options) }));
+    core = jest.requireActual(path.join(coreRoot, 'src/app/api/oauth/authorize/route.js'));
+  });
+
+  beforeEach(async () => {
+    const collections = await mongoose.connection.db.listCollections({}, { nameOnly: true }).toArray();
+    await Promise.all(collections.map((item) => mongoose.connection.db.collection(item.name).deleteMany({})));
+    await User.create({ _id: subject, userName: 'Synthetic', tokenVersion: 0 });
+    await Client.create({
+      clientId, clientSecret: secret, name: 'Synthetic strict client', developerId: subject, redirectUris: [callback], allowedScopes: ['profile'], allowedProviders: ['credentials'], pkcePolicy: 'required_s256', active: true, verified: false,
+    });
+    accessCookie = jwt.sign({ _id: subject, userName: 'Synthetic' }, accessKey, { expiresIn: 3600 });
+    refreshCookie = jwt.sign({ _id: subject, tokenVersion: 0 }, refreshKey, { expiresIn: 3600 });
+    log = jest.spyOn(console, 'log').mockImplementation(() => {});
+  });
+  afterEach(() => log?.mockRestore());
+  afterAll(async () => {
+    await mongoose.disconnect();
+    if (server) await server.stop();
+    keys.forEach((key) => { if (original[key] === undefined) delete process.env[key]; else process.env[key] = original[key]; });
+  });
+  const params = () => ({
+    client_id: clientId, response_type: 'code', redirect_uri: callback, scope: 'profile', state, code_challenge: crypto.createHash('sha256').update(verifier).digest('base64url'), code_challenge_method: 'S256', prompt: 'consent',
+  });
+  const incoming = (method, body, suppliedOrigin = origin) => ({
+    method, url: `${origin}/api/oauth/authorize?${new URLSearchParams(body).toString()}`, headers: { get: (name) => (name === 'origin' ? suppliedOrigin : null) }, json: async () => body,
+  });
+
+  test('real consent DTO without response_type yields one bound code and strict family, then honors persisted central revoke', async () => {
+    const consent = await core.GET(incoming('GET', params()));
+    expect(consent.status).toBe(200);
+    expect(consent.body.authParams.response_type).toBeUndefined();
+    const approved = await core.POST(incoming('POST', { ...consent.body.authParams, approved: true }));
+    expect(approved.status).toBe(200);
+    const returned = new URL(approved.body.redirectUrl);
+    expect(returned.origin).toBe(new URL(callback).origin);
+    expect(returned.searchParams.get('state')).toBe(state);
+    const issuedCode = returned.searchParams.get('code');
+    expect((await Code.findOne({ code: issuedCode }).lean()).strictContext).toMatchObject({ issuer: origin, clientId, tokenVersion: 0 });
+    const post = (operation, body) => request(app).post(`/mana/oauth/strict/v1/${operation}`).auth(clientId, secret).type('form')
+      .send(body);
+    const tokens = await post('token', {
+      grant_type: 'authorization_code', code: issuedCode, redirect_uri: callback, code_verifier: verifier,
+    });
+    expect(tokens.status).toBe(200);
+    expect((await post('introspect', { token: tokens.body.access_token })).body).toMatchObject({
+      active: true, iss: origin, aud: 'urn:synthetic:product', sub: subject,
+    });
+    await User.updateOne({ _id: subject }, { $inc: { tokenVersion: 1 } });
+    expect((await post('introspect', { token: tokens.body.access_token })).body).toEqual({ active: false });
+    expect((await post('token', { grant_type: 'refresh_token', refresh_token: tokens.body.refresh_token })).status).toBe(400);
+    expect((await Client.findOne({ clientId }).lean()).audience).toBe('');
+  });
+
+  test('hostile browser origin cannot reach actual Portal code issuance through core proxy', async () => {
+    const denied = await core.POST(incoming('POST', { ...params(), approved: true }, 'https://other.synthetic.invalid'));
+    expect(denied.status).toBe(403);
+    expect(await Code.countDocuments()).toBe(0);
+  });
+});
