+import { __models } from 'mongoose';
+import { createAuthorizationCode } from '../service/oauthService';
+import { authorizePost } from '../controllers/oauthController';
+
+jest.mock('mongoose', () => {
+  const models = {
+    oauthClient: { findOne: jest.fn() },
+    oauthAuthorizationCode: { create: jest.fn() },
+    oauthAccessToken: {},
+    oauthRefreshToken: {},
+    userBN: {},
+    customer: {},
+  };
+  return { __esModule: true, __models: models, default: { model: (name) => models[name] || {} } };
+});
+jest.mock('../service/userService', () => ({ __esModule: true }));
+
+describe('strict code context is an optional server-owned extension', () => {
+  const clientId = 'synthetic-client';
+  const subject = '507f1f77bcf86cd799439011';
+  const redirect = 'https://synthetic.invalid/callback';
+  const context = Object.freeze({
+    issuer: 'urn:synthetic:authority', audience: 'urn:synthetic:product', clientId, tokenVersion: 0, authoritySessionHash: 'a'.repeat(64),
+  });
+  const legacyArgs = () => [clientId, subject, redirect, ['profile'], 'synthetic-state', 'synthetic-challenge', 'S256'];
+  beforeEach(() => {
+    jest.resetAllMocks();
+    __models.oauthAuthorizationCode.create.mockImplementation(async (data) => ({ ...data, code: 'synthetic-issued-code' }));
+    __models.oauthClient.findOne.mockResolvedValue({
+      active: true, clientId, allowedGrants: ['authorization_code', 'refresh_token'], allowedScopes: ['profile'], validateRedirectUri: (uri) => uri === redirect, validateScope: (scopes) => scopes.every((scope) => scope === 'profile'), incrementRequests: async () => {},
+    });
+  });
+
+  test('legacy service call preserves the exact record shape without a strict field', async () => {
+    await createAuthorizationCode(...legacyArgs());
+    expect(__models.oauthAuthorizationCode.create.mock.calls[0][0]).toEqual({
+      clientId, userId: subject, redirectUri: redirect, scopes: ['profile'], state: 'synthetic-state', codeChallenge: 'synthetic-challenge', codeChallengeMethod: 'S256',
+    });
+  });
+
+  test('explicit strict service context is copied into the issued code', async () => {
+    await createAuthorizationCode(...legacyArgs(), context);
+    const record = __models.oauthAuthorizationCode.create.mock.calls[0][0];
+    expect(record.strictContext).toEqual(context);
+    expect(record.strictContext).not.toBe(context);
+  });
+
+  test.each([{ ...context, clientId: 'other' }, { ...context, tokenVersion: -1 }, { ...context, tokenVersion: undefined }, { ...context, authoritySessionHash: 'raw-secret' }])('invalid strict context is rejected before persistence', async (bad) => {
+    await expect(createAuthorizationCode(...legacyArgs(), bad)).rejects.toThrow();
+    expect(__models.oauthAuthorizationCode.create).not.toHaveBeenCalled();
+  });
+
+  test.each([false, true])('controller uses server context only; present=%s', async (serverContext) => {
+    const req = {
+      user: { _id: subject },
+      body: {
+        client_id: clientId, redirect_uri: redirect, scope: 'profile', state: 'synthetic-state', code_challenge: 'synthetic-challenge', code_challenge_method: 'S256', approved: true, strictAuthContext: { ...context, tokenVersion: 99 },
+      },
+    };
+    if (serverContext) req.strictAuthContext = context;
+    const res = { status: jest.fn().mockReturnThis(), json: jest.fn().mockReturnThis() };
+    await authorizePost(req, res);
+    const record = __models.oauthAuthorizationCode.create.mock.calls[0][0];
+    expect(record.strictContext).toEqual(serverContext ? context : undefined);
+  });
+});
