+        || Array.from(clientId + clientSecret).some((character) => character.charCodeAt(0) < 32 || character.charCodeAt(0) === 127)) return null;
+      return { clientId, clientSecret };
+    } catch {
+      return null;
+    }
+  }
+
+  const error = (res, status, code) => res.status(status).json({ error: code });
+  function handler(operation) {
+    return async (req, res) => {
+      try {
+        if (!req.is('application/x-www-form-urlencoded')) return error(res, 415, 'invalid_request');
+        const auth = credentials(req);
+        if (!auth) return error(res, 401, 'invalid_client');
+        if (!await allowRequest({ clientId: auth.clientId, operation, request: req })) return error(res, 429, 'temporarily_unavailable');
+        const authority = await resolveAuthority(auth.clientId);
+        if (!authority) return error(res, 401, 'invalid_client');
+        const authenticated = await authority.authenticateClient(auth.clientSecret);
+        if (authenticated.status === 'unavailable') return error(res, 503, 'temporarily_unavailable');
+        if (authenticated.status !== 'ok') return error(res, 401, 'invalid_client');
+        const { body } = req;
+        if (!body || typeof body !== 'object' || Array.isArray(body)
+          || Object.values(body).some((value) => typeof value !== 'string')) return error(res, 400, 'invalid_request');
