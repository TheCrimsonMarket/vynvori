@@ -0,0 +1,125 @@
+// Native MongoDB 5.8.1 adapter. Constructing it performs no database mutation.
+// Live collection/index provisioning requires a separately reviewed migration.
+export function createStrictFamilyStore({ families, authorizationCodes } = {}) {
+  if (families?.collectionName !== 'oauth_strict_families_v1'
+    || !authorizationCodes || authorizationCodes === families) {
+    throw new TypeError('Strict families require their own collection and explicit authorization-code adapter');
+  }
+  const options = { returnDocument: 'after', includeResultMetadata: false, upsert: false };
+  const owned = (clientId, familyId) => ({ _id: familyId, clientId });
+
+  return {
+    // Explicit operator/test step only; never invoked from a request path.
+    async ensureIndexes() {
+      await families.createIndex({ authorizationCodeId: 1 }, { unique: true, name: 'strict_unique_code_lineage' });
+      await families.createIndex({ clientId: 1, currentRefreshHash: 1 }, { unique: true, name: 'strict_unique_current_refresh' });
+      await families.createIndex({ clientId: 1, currentAccessHash: 1 }, { unique: true, name: 'strict_unique_current_access' });
+      await families.createIndex({ clientId: 1, spentRefreshHashes: 1 }, { name: 'strict_spent_refresh_lookup' });
+    },
+
+    async readCode(clientId, code) {
+      return authorizationCodes.findOne({ clientId, code });
+    },
+
+    async consumeCode(code, now) {
+      const result = await authorizationCodes.updateOne({
+        _id: code._id,
+        code: code.code,
+        clientId: code.clientId,
+        userId: code.userId,
+        strictContext: code.strictContext,
+        redirectUri: code.redirectUri,
+        codeChallenge: code.codeChallenge,
+        codeChallengeMethod: 'S256',
+        scopes: code.scopes,
+        used: false,
+        expiresAt: { $gt: now },
+      }, { $set: { used: true } });
+      return result.modifiedCount === 1;
+    },
+
+    async createFamily(family) {
+      await families.insertOne(family);
+    },
+
+    async findRefreshFamily(clientId, hash) {
+      return families.findOne({
+        clientId,
+        $or: [{ currentRefreshHash: hash }, { spentRefreshHashes: hash }],
+      });
+    },
+
+    async readAccessRecord(clientId, hash, now) {
+      const record = await families.findOne({
+        clientId,
+        currentAccessHash: hash,
+        state: 'active',
+        refreshExpiresAt: { $gt: now },
+        accessExpiresAt: { $gt: now },
+      });
+      if (!record) return null;
+      return {
+        clientId: record.clientId,
+        userId: record.userId,
+        subjectTokenVersion: record.subjectTokenVersion,
+        scopes: record.scopes,
+        revoked: false,
+        expiresAt: new Date(Math.min(record.accessExpiresAt.getTime(), record.refreshExpiresAt.getTime())),
+      };
+    },
+
+    async claimRotation({
+      familyId, clientId, generation, refreshHash, rotationId, now, maxRotations,
+    }) {
+      if (!Number.isSafeInteger(maxRotations) || maxRotations <= 0
+        || !Number.isSafeInteger(generation) || generation < 0 || generation >= maxRotations) return null;
+      return families.findOneAndUpdate({
+        ...owned(clientId, familyId),
+        state: 'active',
+        generation,
+        currentRefreshHash: refreshHash,
+        refreshExpiresAt: { $gt: now },
+      }, {
+        $set: {
+          state: 'rotating', rotationId, rotationStartedAt: now, updatedAt: now,
+        },
+        $inc: { generation: 1 },
+        $push: { spentRefreshHashes: refreshHash },
+      }, options);
+    },
+
+    async completeRotation({
+      familyId, clientId, generation, rotationId, refreshHash, accessHash, accessExpiresAt, now,
+    }) {
+      const result = await families.updateOne({
+        ...owned(clientId, familyId),
+        state: 'rotating',
+        generation,
+        rotationId,
+        refreshExpiresAt: { $gt: now },
+      }, {
+        $set: {
+          state: 'active', currentRefreshHash: refreshHash, currentAccessHash: accessHash, accessExpiresAt, updatedAt: now,
+        },
+        $unset: { rotationId: '', rotationStartedAt: '' },
+      });
+      return result.modifiedCount === 1;
+    },
+
+    async revokeFamily(clientId, familyId, now) {
+      const result = await families.updateOne({ ...owned(clientId, familyId), state: { $ne: 'revoked' } }, {
+        $set: { state: 'revoked', revokedAt: now, updatedAt: now },
+      });
+      return result.modifiedCount === 1;
+    },
+
+    async revokeByHash(clientId, hash, now) {
+      const result = await families.updateOne({
+        clientId,
+        state: { $ne: 'revoked' },
+        $or: [{ currentRefreshHash: hash }, { spentRefreshHashes: hash }, { currentAccessHash: hash }],
+      }, { $set: { state: 'revoked', revokedAt: now, updatedAt: now } });
+      return result.modifiedCount === 1;
+    },
+  };
+}
