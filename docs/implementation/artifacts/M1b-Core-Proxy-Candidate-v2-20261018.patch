+/** @jest-environment node */
+jest.mock('axios', () => ({ get: jest.fn(), post: jest.fn() }));
+jest.mock('next/headers', () => ({ cookies: jest.fn() }));
+jest.mock('next/server', () => ({
+  NextResponse: { json: (body, options = {}) => ({ body, status: options.status || 200, headers: options.headers || {} }) },
+}));
+
+import axios from 'axios';
+import { cookies } from 'next/headers';
+import { GET, POST } from '../authorize/route';
+
+describe('OAuth authorizer proxy preserves legacy contracts and isolates strict provenance', () => {
+  const keys = ['API_URL', 'CORE_STRICT_OAUTH_CLIENT_IDS', 'CORE_STRICT_OAUTH_WEB_ORIGIN', 'CORE_STRICT_OAUTH_API_BASE_URL'];
+  const original = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+  const origin = 'https://central.synthetic.invalid';
+  const access = 'synthetic-central-access-do-not-log';
+  const refresh = 'synthetic-central-refresh-do-not-log';
+  const parameters = { client_id: 'synthetic-strict', response_type: 'code', redirect_uri: 'https://product.synthetic.invalid/callback', scope: 'profile', state: 'synthetic-state', code_challenge: 'synthetic-challenge', code_challenge_method: 'S256' };
+  let log;
+  let errorLog;
+  beforeEach(() => {
+    jest.clearAllMocks();
+    process.env.API_URL = 'https://portal.synthetic.invalid/mana';
+    delete process.env.CORE_STRICT_OAUTH_CLIENT_IDS;
+    delete process.env.CORE_STRICT_OAUTH_WEB_ORIGIN;
+    delete process.env.CORE_STRICT_OAUTH_API_BASE_URL;
+    cookies.mockReturnValue({ get: (name) => name === 'authToken' ? { value: access } : name === 'refreshToken' ? { value: refresh } : undefined });
+    axios.get.mockResolvedValue({ status: 200, data: { redirectUrl: 'https://product.synthetic.invalid/callback?code=synthetic' } });
+    axios.post.mockResolvedValue({ status: 200, data: { redirectUrl: 'https://product.synthetic.invalid/callback?code=synthetic' } });
+    log = jest.spyOn(console, 'log').mockImplementation(() => {});
+    errorLog = jest.spyOn(console, 'error').mockImplementation(() => {});
+  });
+  afterEach(() => { log.mockRestore(); errorLog.mockRestore(); });
+  afterAll(() => keys.forEach((key) => {
+    if (original[key] === undefined) delete process.env[key];
+    else process.env[key] = original[key];
+  }));
+  function strict() {
+    process.env.CORE_STRICT_OAUTH_CLIENT_IDS = JSON.stringify(['synthetic-strict']);
+    process.env.CORE_STRICT_OAUTH_WEB_ORIGIN = origin;
+    process.env.CORE_STRICT_OAUTH_API_BASE_URL = `${origin}/mana`;
+  }
+  function incoming(method, body = parameters, suppliedOrigin, urlOrigin = origin, extraHeaders = {}) {
+    const values = { ...extraHeaders };
+    if (suppliedOrigin !== undefined) values.origin = suppliedOrigin;
+    return { method, url: `${urlOrigin}/api/oauth/authorize?${new URLSearchParams(body).toString()}`, headers: { get: (name) => values[name.toLowerCase()] || null }, json: async () => body };
+  }
+
+  test('legacy GET retains parameter/cookie/status/response contracts without claiming strict provenance', async () => {
+    const response = await GET(incoming('GET', { ...parameters, client_id: 'legacy' }));
+    expect(response.status).toBe(200);
+    expect(response.body).toEqual({ redirectUrl: 'https://product.synthetic.invalid/callback?code=synthetic' });
+    const [url, config] = axios.get.mock.calls[0];
+    expect(url).toBe('https://portal.synthetic.invalid/mana/oauth/authorize');
+    expect(config.params.client_id).toBe('legacy');
+    expect(config.headers.Cookie).toBe(`authToken=${access}; refreshToken=${refresh}`);
+    expect(config.headers['X-OAuth-Request-Origin']).toBe('null');
+    expect(config.validateStatus(499)).toBe(true);
+    expect(config.validateStatus(500)).toBe(false);
+    expect(response.headers).toEqual({});
+  });
+
+  test('legacy POST still forwards the established consent body without requiring Origin or response_type', async () => {
+    const { response_type: _responseType, ...body } = { ...parameters, client_id: 'legacy', approved: true };
+    const response = await POST(incoming('POST', body));
+    expect(response.status).toBe(200);
+    expect(axios.post.mock.calls[0][1]).toEqual(body);
+    expect(axios.post.mock.calls[0][2].headers.Cookie).toBe(`authToken=${access}; refreshToken=${refresh}`);
+    expect(axios.post.mock.calls[0][2].headers['X-OAuth-Request-Origin']).toBe('null');
+  });
+
+  test.each(['GET', 'POST'])('strict %s sends only server-selected same-origin provenance', async (method) => {
+    strict();
+    const response = await (method === 'GET' ? GET : POST)(incoming(method, { ...parameters, approved: true }, origin, origin, { 'x-oauth-request-origin': 'https://forged.synthetic.invalid' }));
+    expect(response.status).toBe(200);
+    const options = method === 'GET' ? axios.get.mock.calls[0][1] : axios.post.mock.calls[0][2];
+    expect(method === 'GET' ? axios.get.mock.calls[0][0] : axios.post.mock.calls[0][0]).toBe(`${origin}/mana/oauth/authorize`);
+    expect(options.headers['X-OAuth-Request-Origin']).toBe(origin);
+    expect(response.headers['Cache-Control']).toBe('no-store');
+  });
+
+  test('strict top-level GET without Origin is bound to configured request URL origin', async () => {
+    strict();
+    expect((await GET(incoming('GET'))).status).toBe(200);
+    expect((await GET(incoming('GET', parameters, undefined, 'https://other.synthetic.invalid'))).status).toBe(403);
+    expect(axios.get).toHaveBeenCalledTimes(1);
+  });
+
+  test.each([undefined, 'null', 'https://other.synthetic.invalid', `${origin}, https://other.synthetic.invalid`])('strict POST rejects invalid browser origin %s before forwarding cookies', async (suppliedOrigin) => {
+    strict();
+    const response = await POST(incoming('POST', { ...parameters, approved: true }, suppliedOrigin));
+    expect(response.status).toBe(403);
+    expect(cookies).not.toHaveBeenCalled();
+    expect(axios.post).not.toHaveBeenCalled();
+  });
+
+  test('strict enrollment needs an exact configured HTTPS origin', async () => {
+    strict();
+    delete process.env.CORE_STRICT_OAUTH_WEB_ORIGIN;
+    expect((await GET(incoming('GET'))).status).toBe(503);
+    process.env.CORE_STRICT_OAUTH_WEB_ORIGIN = `${origin}/path`;
+    expect((await GET(incoming('GET'))).status).toBe(503);
+    expect(axios.get).not.toHaveBeenCalled();
+  });
+
+  test('strict cookies cannot be sent to a missing or mismatched upstream API base', async () => {
+    strict();
+    process.env.CORE_STRICT_OAUTH_API_BASE_URL = 'https://other.synthetic.invalid/mana';
+    expect((await GET(incoming('GET'))).status).toBe(503);
+    delete process.env.CORE_STRICT_OAUTH_API_BASE_URL;
+    expect((await GET(incoming('GET'))).status).toBe(503);
+    expect(cookies).not.toHaveBeenCalled();
+    expect(axios.get).not.toHaveBeenCalled();
+  });
+
+  test('strict proxy never follows redirects or relays a non-JSON authorization response', async () => {
+    strict();
+    axios.get.mockResolvedValue({ status: 302, data: { redirect: 'https://other.synthetic.invalid' } });
+    const redirected = await GET(incoming('GET'));
+    expect(redirected.status).toBe(502);
+    expect(axios.get.mock.calls[0][1].maxRedirects).toBe(0);
+    axios.get.mockResolvedValue({ status: 200, data: 'synthetic-private-html' });
+    const wrongBody = await GET(incoming('GET'));
+    expect(wrongBody.status).toBe(502);
+    expect(JSON.stringify(wrongBody.body)).not.toContain('synthetic-private-html');
+  });
+
+  test('public upstream 4xx response/status remains intact for legacy and strict clients', async () => {
+    const data = { error: 'interaction_required', error_description: 'Sign in required', loginRequired: true };
+    axios.get.mockResolvedValue({ status: 401, data });
+    expect(await GET(incoming('GET', { ...parameters, client_id: 'legacy' }))).toMatchObject({ status: 401, body: data });
+    strict();
+    expect(await GET(incoming('GET'))).toMatchObject({ status: 401, body: data });
+  });
+
+  test('strict unexpected upstream errors are sanitized; legacy error response retains its contract', async () => {
+    const problem = { message: 'synthetic-private-message', response: { status: 502, data: { error_description: 'synthetic-private-upstream-body' } } };
+    axios.get.mockRejectedValue(problem);
+    expect((await GET(incoming('GET', { ...parameters, client_id: 'legacy' }))).body).toEqual({ error: 'authorization_error', error_description: 'synthetic-private-upstream-body' });
+    strict();
+    const response = await GET(incoming('GET'));
+    expect(response.status).toBe(502);
+    expect(response.body).toEqual({ error: 'authorization_error', error_description: 'Failed to fetch authorization details' });
+  });
+
+  test('logs contain no token prefix, cookies, state, payload or raw exception', async () => {
+    await GET(incoming('GET', { ...parameters, client_id: 'legacy' }));
+    await POST(incoming('POST', { ...parameters, approved: true, note: 'synthetic-private-payload' }));
+    axios.get.mockRejectedValue({ message: 'synthetic-private-message', response: { status: 500, data: { error_description: 'synthetic-private-upstream-body' } } });
+    await GET(incoming('GET'));
+    const recorded = JSON.stringify([...log.mock.calls, ...errorLog.mock.calls]);
+    for (const value of ['synthetic-central', 'synthetic-state', 'synthetic-private-payload', 'synthetic-private-message', 'synthetic-private-upstream-body']) expect(recorded).not.toContain(value);
+  });
+
+  test('strict POST does not accept credentials or server context in the consent body', async () => {
+    strict();
+    const response = await POST(incoming('POST', { ...parameters, approved: true, client_secret: 'synthetic-unexpected-secret', strictAuthContext: { tokenVersion: 99 } }, origin));
+    expect(response.status).toBe(400);
+    expect(axios.post).not.toHaveBeenCalled();
+  });
+
+  test('strict duplicate OAuth query parameters fail closed', async () => {
+    strict();
+    const req = incoming('GET');
+    req.url += '&state=other';
+    expect((await GET(req)).status).toBe(400);
+    expect(axios.get).not.toHaveBeenCalled();
+  });
+
+  test('malformed enrollment configuration cannot mint strict provenance or disrupt a successful legacy request', async () => {
+    process.env.CORE_STRICT_OAUTH_CLIENT_IDS = '{invalid';
+    const response = await GET(incoming('GET', { ...parameters, client_id: 'legacy' }));
+    expect(response.status).toBe(200);
+    expect(axios.get.mock.calls[0][1].headers['X-OAuth-Request-Origin']).toBe('null');
+  });
+
+  test('malformed new enrollment settings preserve the legacy exception-response contract too', async () => {
+    process.env.CORE_STRICT_OAUTH_CLIENT_IDS = '{invalid';
+    axios.post.mockRejectedValue({ message: 'legacy-message', response: { status: 502, data: { error_description: 'legacy-description' } } });
+    const response = await POST(incoming('POST', { client_id: 'legacy', approved: true }));
+    expect(response.status).toBe(502);
+    expect(response.body).toEqual({ error: 'authorization_error', error_description: 'legacy-description' });
+  });
+});
