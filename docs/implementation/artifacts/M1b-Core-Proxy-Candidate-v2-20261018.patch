@@ -0,0 +1,48 @@
+// Server-only enrollment configuration; no browser input can select an authority.
+const legacy = () => ({ strict: false, sanitizeErrors: false, origin: 'null' });
+const deny = (status, description) => ({ strict: true, sanitizeErrors: true, origin: 'null', error: { status, description } });
+
+export function resolveStrictProxyPolicy(request, clientId) {
+  const raw = process.env.CORE_STRICT_OAUTH_CLIENT_IDS;
+  if (!raw) return legacy();
+  let clients;
+  try {
+    clients = JSON.parse(raw);
+    if (!Array.isArray(clients) || clients.some((id) => typeof id !== 'string' || !id || id.trim() !== id)
+      || new Set(clients).size !== clients.length) throw new TypeError('Invalid enrollment');
+  } catch {
+    // No valid enrollment means no strict provenance. Keep legacy contracts intact.
+    return legacy();
+  }
+  if (typeof clientId !== 'string' || !clients.includes(clientId)) return legacy();
+  const expected = process.env.CORE_STRICT_OAUTH_WEB_ORIGIN;
+  const base = process.env.CORE_STRICT_OAUTH_API_BASE_URL;
+  try {
+    const origin = new URL(expected);
+    const api = new URL(base);
+    if (origin.protocol !== 'https:' || origin.origin !== expected || origin.username || origin.password
+      || api.protocol !== 'https:' || api.origin !== expected || api.pathname !== '/mana'
+      || api.username || api.password || api.search || api.hash || api.href !== base) return deny(503, 'Authorization is unavailable');
+    if (new URL(request.url).origin !== expected) return deny(403, 'Origin not allowed');
+    const supplied = request.headers?.get('origin');
+    if ((request.method === 'POST' && supplied !== expected) || (supplied && supplied !== expected)) return deny(403, 'Origin not allowed');
+    return { strict: true, sanitizeErrors: true, origin: expected, apiBaseUrl: base };
+  } catch {
+    return deny(503, 'Authorization is unavailable');
+  }
+}
+
+export function strictApprovalIsValid(body) {
+  const fields = ['response_type', 'client_id', 'redirect_uri', 'scope', 'state', 'code_challenge', 'code_challenge_method', 'provider', 'required_provider', 'prompt', 'approved'];
+  const required = ['client_id', 'redirect_uri', 'scope', 'state', 'code_challenge', 'code_challenge_method'];
+  return body && typeof body === 'object' && !Array.isArray(body)
+    && Object.keys(body).every((field) => fields.includes(field))
+    && typeof body.approved === 'boolean'
+    && (body.response_type === undefined || body.response_type === 'code')
+    && required.every((field) => typeof body[field] === 'string' && body[field].length > 0 && body[field].length <= 4096)
+    && Object.entries(body).every(([field, value]) => field === 'approved' || value == null || typeof value === 'string');
+}
+
+export function strictQueryIsUnambiguous(searchParams) {
+  return [...new Set(searchParams.keys())].every((key) => searchParams.getAll(key).length === 1);
+}
