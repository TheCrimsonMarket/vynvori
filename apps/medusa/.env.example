# Dedicated VYNVORI service only. Never copy LuckyLittleDevil credentials.
M2_ENV=local
M2_MEDUSA_DATABASE_URL=
# Staging runtime URL username: vynvori_medusa_runtime_scoped.
# Separate migration invocation URL username: vynvori_medusa_migration_scoped.
# Never use database owner vynvori_medusa_app or mount a migration URL in runtime.
M2_MEDUSA_DATABASE_NAME=vynvori_medusa_staging
M2_MEDUSA_DATABASE_HOST=
M2_MEDUSA_JWT_SECRET=
M2_MEDUSA_COOKIE_SECRET=
M2_MEDUSA_STORE_CORS=http://localhost:3000
M2_MEDUSA_ADMIN_CORS=http://localhost:9000
M2_MEDUSA_AUTH_CORS=http://localhost:9000
